---
interface Props {
  active: string;
}
const { active } = Astro.props;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <title>Gudang Bahan Baku Roti</title>
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f2ece4; color: #4a2f22; }
    header { background: #5c3d2e; color: #fff; text-align: center; padding: 20px 16px; }
    header h1 { font-size: 1.3rem; }
    header p { opacity: 0.85; font-size: 0.8rem; margin-top: 4px; }
    nav { display: flex; background: #4a2f22; position: sticky; top: 0; z-index: 10; }
    nav a { flex: 1; text-align: center; padding: 10px 2px; color: #d9c7ba; text-decoration: none; font-size: 0.66rem; font-weight: 600; line-height: 1.25; }
    nav a.active { background: #f2ece4; color: #4a2f22; }
    main { padding: 16px; padding-bottom: 60px; }
    .card { background: #fff; border-radius: 14px; padding: 16px; margin-bottom: 12px; }
    button { font: inherit; cursor: pointer; }
    input, select { font: inherit; }
  </style>
</head>
<body>
  <header>
    <h1>🍞 Gudang Bahan Baku Roti</h1>
    <p>Inventory Paperless - Scan & Klik</p>
  </header>
  <nav>
    <a href="/" class={active === "dashboard" ? "active" : ""}>📊 Dashboard</a>
    <a href="/input" class={active === "input" ? "active" : ""}>➕ Input</a>
    <a href="/bahan" class={active === "bahan" ? "active" : ""}>📦 Bahan</a>
    <a href="/opname" class={active === "opname" ? "active" : ""}>📋 Opname</a>
    <a href="/riwayat" class={active === "riwayat" ? "active" : ""}>📝 Riwayat</a>
  </nav>
  <main>
    <slot />
  </main>
</body>
</html>
