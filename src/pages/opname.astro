---
import Layout from "../layouts/Layout.astro";
---

<Layout active="opname">

  <!-- =====================================================
       PETUGAS & PENCARIAN
       ===================================================== -->

  <div class="card">

    <div class="petugasBox">
      👤 Petugas:
      <strong id="petugasName">-</strong>
    </div>

    <label for="searchBox">
      Cari bahan (opsional)
    </label>

    <input
      type="text"
      id="searchBox"
      placeholder="Ketik untuk filter bahan..."
      autocomplete="off"
    />

  </div>


  <!-- =====================================================
       DAFTAR BAHAN
       ===================================================== -->

  <div class="card">

    <div class="listHeader">
      <span>Bahan</span>
      <span>Stok Fisik</span>
    </div>

    <div id="opnameList">
      Memuat...
    </div>

  </div>


  <!-- =====================================================
       SIMPAN
       ===================================================== -->

  <button
    id="btnSubmit"
    class="btn-primary"
  >
    ✅ Simpan Hasil Opname
  </button>

  <div id="formMsg"></div>


  <style is:global>

    .petugasBox {
      background: #f9f5f0;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.9rem;
      margin-bottom: 4px;
    }

    label {
      display: block;
      font-size: 0.8rem;
      color: #8a7566;
      margin: 10px 0 4px;
    }

    input[type="text"] {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ddd;
      border-radius: 10px;
      background: #fafafa;
      box-sizing: border-box;
    }

    .listHeader {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      color: #8a7566;
      font-weight: 600;
      padding: 0 2px 8px;
      border-bottom: 1px solid #eee;
      margin-bottom: 4px;
    }

    .opnameRow {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 2px;
      border-bottom: 1px solid #f0f0f0;
      gap: 10px;
    }

    .opnameRow:last-child {
      border-bottom: none;
    }

    .opnameInfo {
      flex: 1;
      min-width: 0;
    }

    .opnameNama {
      font-weight: 600;
      font-size: 0.88rem;
    }

    .opnameSub {
      font-size: 0.72rem;
      color: #8a7566;
    }

    .opnameInput {
      width: 84px;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 8px;
      text-align: center;
      font-size: 0.95rem;
      box-sizing: border-box;
    }

    .opnameInput.changed {
      border-color: #b5651d;
      background: #fdecd2;
      font-weight: 700;
    }

    .opnameInput.invalid {
      border-color: #c62828;
      background: #ffebee;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      background: #5c3d2e;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-weight: 600;
      margin-top: 4px;
      cursor: pointer;
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #formMsg {
      font-size: 0.85rem;
      margin-top: 10px;
      text-align: center;
      min-height: 20px;
    }

    #formMsg.ok {
      color: #2e7d32;
    }

    #formMsg.err {
      color: #c62828;
    }

  </style>


  <script>

    const API_URL =
      import.meta.env.PUBLIC_API_URL;


    // =====================================================
    // DATA
    // =====================================================

    let allBahan = [];

    /*
     * Menyimpan hasil input berdasarkan SKU.
     *
     * Penting:
     * Search/filter tidak boleh membuat nilai
     * yang sudah diedit hilang.
     */
    const opnameValues = {};


    // =====================================================
    // PETUGAS
    // =====================================================

    function getPetugas() {

      try {

        const data =
          JSON.parse(
            localStorage.getItem(
              'gudangPetugas'
            ) || 'null'
          );

        return data?.nama || '';

      } catch (err) {

        return '';

      }

    }


    document
      .getElementById('petugasName')
      .textContent =
        getPetugas() || '-';


    // =====================================================
    // RENDER LIST
    // =====================================================

    function renderList(list) {

      const el =
        document.getElementById(
          'opnameList'
        );


      if (!list.length) {

        el.innerHTML =
          `
            <p
              style="
                color:#8a7566;
                font-size:0.85rem;
                padding:8px 0;
              "
            >
              Gak ada bahan yang cocok.
            </p>
          `;

        return;

      }


      el.innerHTML =
        list.map(p => {

          /*
           * Ambil nilai yang sudah diedit.
           * Kalau belum pernah diedit,
           * gunakan stok sistem.
           */

          const value =
            opnameValues[p.sku] !== undefined
              ? opnameValues[p.sku]
              : p.stok;


          return `
            <div class="opnameRow">

              <div class="opnameInfo">

                <div class="opnameNama">
                  ${p.nama}
                </div>

                <div class="opnameSub">
                  ${p.sku}
                  |
                  Sistem:
                  ${p.stok}
                  ${p.satuan}
                </div>

              </div>


              <input
                type="number"
                class="opnameInput"
                data-sku="${p.sku}"
                data-original="${p.stok}"
                value="${value}"
                step="0.1"
                min="0"
                inputmode="decimal"
              />

            </div>
          `;

        }).join('');


      // ===================================================
      // EVENT INPUT
      // ===================================================

      el
        .querySelectorAll('.opnameInput')
        .forEach(input => {

          updateInputState(input);


          input.addEventListener(
            'input',
            () => {

              const sku =
                input.dataset.sku;

              /*
               * Simpan sebagai STRING terlebih dahulu.
               *
               * Jangan langsung Number(),
               * karena input kosong harus dianggap
               * kosong / invalid, bukan angka 0.
               */

              opnameValues[sku] =
                input.value;

              updateInputState(input);

            }
          );

        });

    }


    // =====================================================
    // STATUS INPUT
    // =====================================================

    function updateInputState(input) {

      const original =
        parseFloat(
          input.dataset.original
        );

      const raw =
        input.value.trim();

      input.classList.remove(
        'changed',
        'invalid'
      );


      // Kosong = invalid

      if (raw === '') {

        input.classList.add(
          'invalid'
        );

        return;

      }


      const current =
        parseFloat(raw);


      // Bukan angka = invalid

      if (isNaN(current)) {

        input.classList.add(
          'invalid'
        );

        return;

      }


      // Nilai berubah dari sistem

      if (current !== original) {

        input.classList.add(
          'changed'
        );

      }

    }


    // =====================================================
    // LOAD MASTER BAHAN
    // =====================================================

    async function loadBahan() {

      const el =
        document.getElementById(
          'opnameList'
        );


      try {

        el.textContent =
          'Memuat...';


        const res =
          await fetch(
            `${API_URL}?action=getMasterData`
          );


        if (!res.ok) {

          throw new Error(
            'HTTP ' + res.status
          );

        }


        const data =
          await res.json();


        if (!Array.isArray(data)) {

          throw new Error(
            'Format data tidak valid'
          );

        }


        allBahan = data;


        /*
         * Inisialisasi nilai opname.
         *
         * Hanya dilakukan jika SKU belum
         * memiliki nilai yang diedit.
         */

        allBahan.forEach(p => {

          if (
            opnameValues[p.sku] === undefined
          ) {

            opnameValues[p.sku] =
              p.stok;

          }

        });


        renderList(
          allBahan
        );


      } catch (err) {

        console.error(
          'loadBahan:',
          err
        );


        el.innerHTML =
          `
            <p style="color:#c62828;">
              Gagal memuat data bahan.
            </p>
          `;

      }

    }


    // =====================================================
    // SEARCH
    // =====================================================

    document
      .getElementById('searchBox')
      .addEventListener(
        'input',
        event => {

          const q =
            event.target.value
              .toLowerCase()
              .trim();


          const filtered =
            q === ''
              ? allBahan
              : allBahan.filter(
                  p =>
                    String(p.nama)
                      .toLowerCase()
                      .includes(q) ||

                    String(p.sku)
                      .toLowerCase()
                      .includes(q)
                );


          renderList(
            filtered
          );

        }
      );


    // =====================================================
    // SIMPAN OPNAME
    //
    // SEMUA BAHAN dikirim.
    //
    // Tidak peduli:
    // - selisih 0
    // - selisih +
    // - selisih -
    //
    // Backend akan mencatat semuanya sebagai
    // transaksi tipe "Opname".
    // =====================================================

    document
      .getElementById('btnSubmit')
      .addEventListener(
        'click',
        async () => {

          const msgEl =
            document.getElementById(
              'formMsg'
            );

          const btn =
            document.getElementById(
              'btnSubmit'
            );


          const petugas =
            getPetugas();


          // -------------------------------------------------
          // VALIDASI PETUGAS
          // -------------------------------------------------

          if (!petugas) {

            msgEl.textContent =
              'Pilih petugas dulu.';

            msgEl.className =
              'err';

            return;

          }


          // -------------------------------------------------
          // VALIDASI MASTER
          // -------------------------------------------------

          if (!allBahan.length) {

            msgEl.textContent =
              'Tidak ada data bahan untuk di-opname.';

            msgEl.className =
              'err';

            return;

          }


          // -------------------------------------------------
          // SUSUN SEMUA BAHAN
          // -------------------------------------------------

          const items =
            allBahan.map(p => {

              const raw =
                opnameValues[p.sku];


              return {

                sku:
                  p.sku,

                stokFisik:
                  raw === undefined ||
                  raw === ''
                    ? NaN
                    : parseFloat(raw)

              };

            });


          // -------------------------------------------------
          // VALIDASI NILAI FISIK
          // -------------------------------------------------

          const invalid =
            items.find(
              item =>
                isNaN(
                  item.stokFisik
                ) ||
                item.stokFisik < 0
            );


          if (invalid) {

            msgEl.textContent =
              `Ada stok fisik yang belum valid (${invalid.sku}).`;

            msgEl.className =
              'err';

            return;

          }


          // -------------------------------------------------
          // KONFIRMASI
          // -------------------------------------------------

          const konfirmasi =
            confirm(
              `Simpan hasil opname untuk ${items.length} bahan?\n\n` +
              `Semua bahan akan dicatat, termasuk yang selisihnya 0.`
            );


          if (!konfirmasi) {

            return;

          }


          // -------------------------------------------------
          // LOCK BUTTON
          // -------------------------------------------------

          btn.disabled =
            true;

          msgEl.textContent =
            'Menyimpan hasil opname...';

          msgEl.className =
            '';


          // -------------------------------------------------
          // KIRIM KE SERVER
          // -------------------------------------------------

          try {

            const res =
              await fetch(
                API_URL,
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'text/plain;charset=utf-8'
                  },

                  body:
                    JSON.stringify({

                      action:
                        'saveOpname',

                      data: {

                        petugas,

                        items

                      }

                    })

                }
              );


            if (!res.ok) {

              throw new Error(
                'HTTP ' + res.status
              );

            }


            const result =
              await res.json();


            // ------------------------------------------------
            // BERHASIL
            // ------------------------------------------------

            if (result.success) {

              msgEl.textContent =
                result.message;

              msgEl.className =
                'ok';


              /*
               * Setelah opname selesai,
               * reload stok sistem terbaru.
               */

              document
                .getElementById(
                  'searchBox'
                )
                .value = '';


              /*
               * Reset nilai opname.
               *
               * Karena opname sudah disimpan,
               * nilai fisik sekarang menjadi
               * stok sistem baru.
               */

              Object.keys(
                opnameValues
              ).forEach(
                key =>
                  delete opnameValues[key]
              );


              await loadBahan();


            } else {

              msgEl.textContent =
                'Gagal: ' +
                (
                  result.message ||
                  'Opname gagal disimpan.'
                );

              msgEl.className =
                'err';

            }


          } catch (err) {

            console.error(
              'saveOpname:',
              err
            );


            msgEl.textContent =
              'Gagal terhubung ke server.';

            msgEl.className =
              'err';


          } finally {

            btn.disabled =
              false;

          }

        }
      );


    // =====================================================
    // START
    // =====================================================

    loadBahan();

  </script>

</Layout>