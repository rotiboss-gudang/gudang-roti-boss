---
import Layout from "../layouts/Layout.astro";
---

<Layout active="resep">
  <div class="card">
    <h2 class="sectionTitle">🏭 Produksi</h2>

    <label>Petugas</label>
    <select id="prodPetugas"><option value="">Pilih petugas...</option></select>

    <label>Produk</label>
    <select id="prodProduk"><option value="">Pilih resep...</option></select>

    <div id="resepPreview"></div>

    <label>Jumlah Batch</label>
    <div class="qtyRow">
      <button id="batchMinus" class="qtyBtn" type="button">−</button>
      <input type="number" id="prodBatch" value="1" min="1" step="1" />
      <button id="batchPlus" class="qtyBtn" type="button">+</button>
    </div>

    <button id="btnProduksi" class="btn-primary" type="button">🏭 Produksi Sekarang</button>
    <div id="prodMsg"></div>
  </div>

  <div class="card">
    <h2 class="sectionTitle">➕ Tambah Bahan ke Resep</h2>

    <label>Nama Produk</label>
    <input type="text" id="rProduk" placeholder="misal: Roti Tawar" autocomplete="off" />

    <label>Bahan Baku</label>
    <div class="searchWrap">
      <input type="text" id="rBahanSearch" placeholder="Ketik nama bahan..." autocomplete="off" />
      <div id="rBahanResults" class="searchResults hidden"></div>
    </div>

    <label>Qty per Batch</label>
    <input type="number" id="rQty" placeholder="misal: 5" step="0.01" min="0.01" />

    <button id="btnAddResep" class="btn-primary" type="button">Tambah ke Resep</button>
    <div id="addMsg"></div>
  </div>

  <div class="card">
    <h2 class="sectionTitle">🧾 Semua Resep</h2>
    <div id="resepList">Memuat...</div>
  </div>

  <style is:global>
    .sectionTitle { margin-bottom: 12px; font-size: 1rem; }
    label { display: block; font-size: .8rem; color: #8a7566; margin: 12px 0 4px; }
    label:first-of-type { margin-top: 0; }
    select, input[type="text"], input[type="number"] { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 10px; background: #fafafa; box-sizing: border-box; }
    .searchWrap { position: relative; }
    .searchResults { position: relative; margin-top: 4px; max-height: 200px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px; background: #fff; }
    .searchResults.hidden { display: none; }
    .searchItem { padding: 10px 12px; border-bottom: 1px solid #f0f0f0; font-size: .85rem; cursor: pointer; }
    .searchItem:last-child { border-bottom: none; }
    .searchItem:active { background: #f2ece4; }
    .qtyRow { display: flex; align-items: center; gap: 10px; }
    .qtyRow input { text-align: center; flex: 1; }
    .qtyBtn { width: 44px; height: 44px; border-radius: 50%; border: none; background: #f2ece4; color: #5c3d2e; font-size: 1.3rem; font-weight: 700; }
    .btn-primary { width: 100%; padding: 14px; background: #5c3d2e; color: #fff; border: none; border-radius: 12px; font-weight: 600; margin-top: 12px; }
    .btn-primary:disabled { opacity: .6; }
    #prodMsg, #addMsg { font-size: .85rem; margin-top: 10px; white-space: pre-line; }
    #prodMsg.ok, #addMsg.ok { color: #2e7d32; }
    #prodMsg.err, #addMsg.err { color: #c62828; font-weight: 600; }
    #resepPreview { font-size: .78rem; color: #8a7566; margin-top: 8px; background: #f9f5f0; border-radius: 8px; padding: 8px 10px; }
    #resepPreview .item { display: flex; justify-content: space-between; padding: 2px 0; gap: 8px; }
    .resepGroup { margin-bottom: 16px; }
    .resepGroup:last-child { margin-bottom: 0; }
    .resepGroupTitle { font-weight: 700; font-size: .92rem; margin-bottom: 6px; }
    .resepItem { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f0f0f0; font-size: .82rem; gap: 8px; }
    .resepItem:last-child { border-bottom: none; }
    .btnDelItem { color: #c62828; background: none; border: none; font-size: .75rem; padding: 4px 8px; white-space: nowrap; }
  </style>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL;
    let allBahan = [];
    let resepData = [];
    let selectedBahanSku = "";

    function getPetugas() {
      try {
        const data = JSON.parse(localStorage.getItem("gudangPetugas") || "null");
        return data?.nama || "";
      } catch { return ""; }
    }

    async function loadUsers() {
      const sel = document.getElementById("prodPetugas");
      try {
        const res = await fetch(`${API_URL}?action=getUsers`);
        const users = await res.json();
        sel.innerHTML = '<option value="">Pilih petugas...</option>' +
          users.map(u => `<option value="${u.nama}">${u.nama}</option>`).join("");
      } catch {
        const current = getPetugas();
        sel.innerHTML = current
          ? `<option value="${current}">${current}</option>`
          : '<option value="">Pilih petugas...</option>';
      }
      const current = getPetugas();
      if (current) sel.value = current;
    }

    async function loadBahan() {
      const res = await fetch(`${API_URL}/api/bahan`);
      const result = await res.json();
      if (!result.success) throw new Error(result.message || "Gagal mengambil bahan");
      allBahan = result.data || [];
    }

    function groupResep(rows) {
      const bahanMap = new Map(allBahan.map(b => [b.sku, b]));
      const groups = new Map();

      for (const row of rows) {
        if (!groups.has(row.produk)) groups.set(row.produk, { produk: row.produk, bahan: [] });
        const bahan = bahanMap.get(row.sku);
        groups.get(row.produk).bahan.push({
          sku: row.sku,
          nama: bahan?.nama || row.sku,
          satuan: bahan?.satuan || "",
          qtyPerBatch: Number(row.qtyPerBatch) || 0,
          stokTersedia: Number(bahan?.stok) || 0
        });
      }
      return [...groups.values()];
    }

    async function loadResep() {
      const listEl = document.getElementById("resepList");
      const prodSel = document.getElementById("prodProduk");
      const res = await fetch(`${API_URL}/api/resep`);
      const result = await res.json();
      if (!result.success) throw new Error(result.message || "Gagal mengambil resep");

      resepData = groupResep(result.data || []);
      prodSel.innerHTML = '<option value="">Pilih resep...</option>' +
        resepData.map(r => `<option value="${r.produk}">${r.produk}</option>`).join("");

      if (!resepData.length) {
        listEl.innerHTML = '<p style="color:#8a7566;font-size:.85rem;">Belum ada resep. Tambahin dulu di form atas.</p>';
        updatePreview();
        return;
      }

      listEl.innerHTML = resepData.map(r => `
        <div class="resepGroup">
          <div class="resepGroupTitle">${r.produk}</div>
          ${r.bahan.map(b => `
            <div class="resepItem">
              <span>${b.nama} — ${b.qtyPerBatch} ${b.satuan}/batch</span>
              <button class="btnDelItem" type="button" data-produk="${r.produk}" data-sku="${b.sku}">✕ Hapus</button>
            </div>
          `).join("")}
        </div>
      `).join("");

      listEl.querySelectorAll(".btnDelItem").forEach(btn => {
        btn.addEventListener("click", () => deleteItem(btn.dataset.produk, btn.dataset.sku));
      });
      updatePreview();
    }

    async function deleteItem(produk, sku) {
      if (!confirm(`Hapus bahan ini dari resep "${produk}"?`)) return;
      const res = await fetch(`${API_URL}/api/resep`, {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ produk, sku })
      });
      const result = await res.json();
      if (!result.success) return alert("Gagal: " + (result.message || "Gagal menghapus resep"));
      await loadResep();
    }

    const bSearch = document.getElementById("rBahanSearch");
    const bResults = document.getElementById("rBahanResults");

    function refreshBahanResults() {
      const q = bSearch.value.toLowerCase().trim();
      const filtered = q ? allBahan.filter(b => b.nama.toLowerCase().includes(q)) : allBahan;

      bResults.innerHTML = filtered.length
        ? filtered.map(b => `<div class="searchItem" data-sku="${b.sku}">${b.nama} (${b.satuan})</div>`).join("")
        : '<div class="searchItem">Gak ketemu</div>';

      bResults.querySelectorAll(".searchItem[data-sku]").forEach(item => {
        item.addEventListener("click", () => {
          selectedBahanSku = item.dataset.sku;
          bSearch.value = item.textContent;
          bResults.classList.add("hidden");
        });
      });
      bResults.classList.remove("hidden");
    }

    bSearch.addEventListener("focus", refreshBahanResults);
    bSearch.addEventListener("input", () => {
      selectedBahanSku = "";
      refreshBahanResults();
    });
    document.addEventListener("click", e => {
      if (!e.target.closest(".searchWrap")) bResults.classList.add("hidden");
    });

    document.getElementById("btnAddResep").addEventListener("click", async () => {
      const msgEl = document.getElementById("addMsg");
      const btn = document.getElementById("btnAddResep");
      const produk = document.getElementById("rProduk").value.trim();
      const qty = Number(document.getElementById("rQty").value);

      if (!produk) return showMsg(msgEl, "Nama produk wajib diisi", false);
      if (!selectedBahanSku) return showMsg(msgEl, "Pilih bahan dari daftar dulu", false);
      if (!Number.isFinite(qty) || qty <= 0) return showMsg(msgEl, "Qty per batch harus lebih dari 0", false);

      btn.disabled = true;
      showMsg(msgEl, "Menyimpan...", null);

      try {
        const res = await fetch(`${API_URL}/api/resep`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ produk, sku: selectedBahanSku, qtyPerBatch: qty })
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message || "Gagal menyimpan resep");

        showMsg(msgEl, result.message || "Resep berhasil ditambahkan", true);
        document.getElementById("rProduk").value = "";
        bSearch.value = "";
        document.getElementById("rQty").value = "";
        selectedBahanSku = "";
        await loadResep();
      } catch (err) {
        showMsg(msgEl, err.message || "Gagal terhubung ke server", false);
      } finally {
        btn.disabled = false;
      }
    });

    function showMsg(el, text, ok) {
      el.textContent = text;
      el.className = ok === true ? "ok" : ok === false ? "err" : "";
    }

    function updatePreview() {
      const produk = document.getElementById("prodProduk").value;
      const batch = Number(document.getElementById("prodBatch").value) || 0;
      const previewEl = document.getElementById("resepPreview");
      const resep = resepData.find(r => r.produk === produk);
      if (!resep) { previewEl.innerHTML = ""; return; }

      previewEl.innerHTML = resep.bahan.map(b => {
        const butuh = b.qtyPerBatch * batch;
        const cukup = b.stokTersedia >= butuh;
        return `<div class="item" style="${cukup ? "" : "color:#c62828;font-weight:700;"}"><span>${b.nama}</span><span>${butuh} / ${b.stokTersedia} ${b.satuan} ${cukup ? "" : "☠️"}</span></div>`;
      }).join("");
    }

    document.getElementById("batchMinus").addEventListener("click", () => {
      const el = document.getElementById("prodBatch");
      el.value = Math.max(1, Number(el.value || 1) - 1);
      updatePreview();
    });

    document.getElementById("batchPlus").addEventListener("click", () => {
      const el = document.getElementById("prodBatch");
      el.value = Math.max(1, Number(el.value || 0) + 1);
      updatePreview();
    });

    document.getElementById("prodBatch").addEventListener("input", updatePreview);
    document.getElementById("prodProduk").addEventListener("change", updatePreview);

    document.getElementById("btnProduksi").addEventListener("click", async () => {
      const msgEl = document.getElementById("prodMsg");
      const btn = document.getElementById("btnProduksi");
      const petugas = document.getElementById("prodPetugas").value;
      const produk = document.getElementById("prodProduk").value;
      const jumlahBatch = Number(document.getElementById("prodBatch").value);

      if (!petugas) return showMsg(msgEl, "Pilih petugas dulu", false);
      if (!produk) return showMsg(msgEl, "Pilih produk dulu", false);
      if (!Number.isInteger(jumlahBatch) || jumlahBatch < 1) return showMsg(msgEl, "Jumlah batch tidak valid", false);
      if (!confirm(`Produksi "${produk}" x${jumlahBatch} batch? Ini bakal motong stok semua bahan sekaligus.`)) return;

      btn.disabled = true;
      showMsg(msgEl, "Memproses...", null);

      try {
        const res = await fetch(`${API_URL}/api/produksi`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ produk, jumlahBatch, petugas })
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message || "Produksi gagal");

        showMsg(msgEl, result.message || "Produksi berhasil", true);
        document.getElementById("prodBatch").value = "1";
        await loadBahan();
        await loadResep();
      } catch (err) {
        showMsg(msgEl, err.message || "Gagal terhubung ke server", false);
      } finally {
        btn.disabled = false;
      }
    });

    async function init() {
      try {
        await Promise.all([loadUsers(), loadBahan()]);
        await loadResep();
      } catch (err) {
        console.error("init resep", err);
        document.getElementById("resepList").innerHTML = '<p style="color:#c62828;">Gagal memuat data resep/bahan.</p>';
      }
    }

    init();
  </script>
</Layout>
