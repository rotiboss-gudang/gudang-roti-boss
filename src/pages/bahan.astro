---
import Layout from "../layouts/Layout.astro";
---

<Layout active="bahan">
  <div class="card">
    <button id="btnToggleForm" class="btn-primary">➕ Tambah Bahan Baru</button>
  </div>

  <div class="card" id="formCard" style="display:none;">
    <h2 style="margin-bottom:12px;">Bahan Baru</h2>

    <label>Nama Bahan *</label>
    <input type="text" id="fNama" placeholder="misal: Tepung Terigu Protein Tinggi" />

    <label>Kategori</label>
    <input type="text" id="fKategori" placeholder="misal: Tepung, Gula, Lemak" />

    <div class="row2">
      <div>
        <label>Satuan *</label>
        <input type="text" id="fSatuan" placeholder="kg / L / butir" />
      </div>
      <div>
        <label>Stok Awal</label>
        <input type="number" id="fStokAwal" placeholder="0" min="0" step="any" />
      </div>
    </div>

    <div class="row2">
      <div>
        <label>Min. Stok</label>
        <input type="number" id="fMinStok" placeholder="0" min="0" step="any" />
      </div>
      <div>
        <label>Expired (opsional)</label>
        <input type="date" id="fExp" />
      </div>
    </div>

    <label>SKU (kosongkan untuk auto-generate)</label>
    <input type="text" id="fSku" placeholder="misal: TEP004, atau scan barcode kemasan" />

    <button type="button" id="btnScan" class="btn-scan">📷 Scan Barcode buat isi SKU</button>
    <div id="reader" class="hidden"></div>
    <div id="scanMsg" class="scanMsg"></div>

    <div id="formMsg"></div>
    <button id="btnSubmit" class="btn-primary" style="margin-top:12px;">Simpan Bahan</button>
  </div>

  <div class="card">
    <h2 style="margin-bottom:12px;">📦 Semua Bahan (<span id="totalCount">-</span>)</h2>
    <input type="text" id="searchBox" placeholder="Cari nama bahan..." style="margin-bottom:12px; width:100%;" />
    <div id="bahanList">Memuat...</div>
  </div>

  <style is:global>
    label { display: block; font-size: 0.8rem; color: #8a7566; margin: 10px 0 4px; }
    input[type="text"], input[type="number"], input[type="date"] {
      width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 10px; background: #fafafa; box-sizing: border-box;
    }
    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .btn-primary { width: 100%; padding: 14px; background: #5c3d2e; color: #fff; border: none; border-radius: 12px; font-weight: 600; }
    .btn-primary:disabled { opacity: 0.6; }
    .btn-scan { width: 100%; padding: 12px; border: 2px dashed #5c3d2e; background: #fff; color: #5c3d2e; border-radius: 12px; font-weight: 600; margin-top: 8px; }
    #reader { width: 100% !important; border-radius: 16px; overflow: hidden; margin-top: 10px; }
    #reader video { border-radius: 16px; }
    .hidden { display: none; }
    .scanMsg { font-size: 0.8rem; color: #2e7d32; margin-top: 6px; }
    .item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; gap: 8px; }
    .item:last-child { border-bottom: none; }
    .itemInfo { flex: 1; min-width: 0; }
    .item .nama { font-weight: 600; font-size: 0.9rem; }
    .item .sub { font-size: 0.78rem; color: #8a7566; }
    .itemRight { display: flex; align-items: center; gap: 8px; }
    .tag { font-size: 0.72rem; padding: 4px 10px; border-radius: 20px; white-space: nowrap; }
    .tag.aman { background: #e3f2e3; color: #2e7d32; }
    .tag.menipis { background: #fdecd2; color: #b5651d; }
    .tag.expired { background: #fbdcdc; color: #b52a2a; }
    .btnDelBahan { background: none; border: none; font-size: 1.1rem; padding: 4px 6px; color: #c62828; }
    #formMsg { font-size: 0.82rem; margin-top: 8px; }
    #formMsg.ok { color: #2e7d32; }
    #formMsg.err { color: #c62828; }
  </style>

  <script src="https://unpkg.com/html5-qrcode" is:inline></script>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "https://gudang-roti-boss-worker.masbamganteng.workers.dev";
    let allBahan = [];
    let html5QrCode = null;
    let scanning = false;

    function getPetugas() {
      try {
        const data = JSON.parse(localStorage.getItem("gudangPetugas") || "null");
        return data?.nama || "";
      } catch {
        return "";
      }
    }

    async function apiRequest(path, options = {}) {
      const res = await fetch(`${API_URL}${path}`, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          ...(options.headers || {})
        }
      });

      let result;
      try {
        result = await res.json();
      } catch (e) {
        throw new Error(`Server mengembalikan response tidak valid (${res.status})`);
      }

      if (!res.ok || !result.success) {
        throw new Error(result.message || result.error || `Request gagal (${res.status})`);
      }

      return result;
    }

    function getStatus(p) {
      const stok = Number(p.stok) || 0;
      const minStok = Number(p.minStok) || 0;

      if (p.expired) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const exp = new Date(p.expired + "T00:00:00");

        if (!Number.isNaN(exp.getTime())) {
          if (exp < today) return "EXPIRED";
          const diff = Math.ceil((exp.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
          if (diff <= 7) return "EXPIRED_SOON";
        }
      }

      if (stok <= minStok) return "MENIPIS";
      return "AMAN";
    }

    function tagClass(status) {
      if (status === "MENIPIS") return "menipis";
      if (status === "EXPIRED" || status === "EXPIRED_SOON") return "expired";
      return "aman";
    }

    function tagText(p) {
      const status = getStatus(p);
      if (status === "MENIPIS") return "Menipis";
      if (status === "EXPIRED") return "Expired";
      if (status === "EXPIRED_SOON") return `Exp ${p.expired}`;
      return "Aman";
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function renderList(list) {
      const el = document.getElementById("bahanList");
      document.getElementById("totalCount").textContent = list.length;

      if (list.length === 0) {
        el.innerHTML = '<p style="color:#8a7566;font-size:0.85rem;">Gak ada bahan yang cocok.</p>';
        return;
      }

      el.innerHTML = list.map(p => `
        <div class="item">
          <div class="itemInfo">
            <div class="nama">${escapeHtml(p.nama)}</div>
            <div class="sub">${escapeHtml(p.sku)} | Stok: ${Number(p.stok) || 0} ${escapeHtml(p.satuan || "")} | Min: ${Number(p.minStok) || 0}</div>
          </div>
          <div class="itemRight">
            <span class="tag ${tagClass(getStatus(p))}">${tagText(p)}</span>
            <button class="btnDelBahan" data-sku="${escapeHtml(p.sku)}" data-nama="${escapeHtml(p.nama)}" title="Hapus">🗑️</button>
          </div>
        </div>
      `).join("");

      el.querySelectorAll(".btnDelBahan").forEach(btn => {
        btn.addEventListener("click", () => deleteBahan(btn.dataset.sku, btn.dataset.nama));
      });
    }

    async function loadBahan() {
      const el = document.getElementById("bahanList");
      try {
        const result = await apiRequest("/api/bahan");
        allBahan = Array.isArray(result.data) ? result.data : [];
        renderList(allBahan);
      } catch (err) {
        console.error(err);
        el.innerHTML = `<p style="color:#c62828;">Gagal memuat data: ${escapeHtml(err.message)}</p>`;
        document.getElementById("totalCount").textContent = "0";
      }
    }

    async function deleteBahan(sku, nama) {
      if (!confirm(`Hapus "${nama}" dari daftar bahan?\n\nBahan akan dihapus dari database.`)) return;

      try {
        await apiRequest("/api/bahan", {
          method: "DELETE",
          body: JSON.stringify({ sku })
        });
        await loadBahan();
      } catch (err) {
        alert("Gagal: " + err.message);
      }
    }

    function generateSku() {
      let max = 0;
      for (const bahan of allBahan) {
        const match = String(bahan.sku || "").match(/^BHN(\d+)$/i);
        if (match) max = Math.max(max, Number(match[1]));
      }
      return `BHN${String(max + 1).padStart(3, "0")}`;
    }

    document.getElementById("btnToggleForm").addEventListener("click", () => {
      const formCard = document.getElementById("formCard");
      formCard.style.display = formCard.style.display === "none" ? "block" : "none";
    });

    document.getElementById("btnScan").addEventListener("click", async () => {
      const readerDiv = document.getElementById("reader");
      const btnScan = document.getElementById("btnScan");
      const scanMsg = document.getElementById("scanMsg");
      scanMsg.textContent = "";
      scanMsg.style.color = "#2e7d32";

      if (scanning) {
        try { await html5QrCode.stop(); } catch (e) {}
        readerDiv.classList.add("hidden");
        btnScan.textContent = "📷 Scan Barcode buat isi SKU";
        scanning = false;
        return;
      }

      readerDiv.classList.remove("hidden");
      btnScan.textContent = "⏹️ Stop Scan";
      html5QrCode = new Html5Qrcode("reader");

      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: 220 },
          decodedText => {
            document.getElementById("fSku").value = decodedText.trim();
            scanMsg.textContent = `Barcode "${decodedText}" berhasil diisi ke SKU`;
            html5QrCode.stop().then(() => {
              readerDiv.classList.add("hidden");
              btnScan.textContent = "📷 Scan Barcode buat isi SKU";
              scanning = false;
            }).catch(() => { scanning = false; });
          },
          () => {}
        );
        scanning = true;
      } catch (err) {
        scanMsg.textContent = "Gagal akses kamera: " + err;
        scanMsg.style.color = "#c62828";
        readerDiv.classList.add("hidden");
        btnScan.textContent = "📷 Scan Barcode buat isi SKU";
        scanning = false;
      }
    });

    document.getElementById("searchBox").addEventListener("input", e => {
      const q = e.target.value.trim().toLowerCase();
      renderList(!q ? allBahan : allBahan.filter(p => String(p.nama || "").toLowerCase().includes(q)));
    });

    document.getElementById("btnSubmit").addEventListener("click", async () => {
      const nama = document.getElementById("fNama").value.trim();
      const satuan = document.getElementById("fSatuan").value.trim();
      const msgEl = document.getElementById("formMsg");
      const btn = document.getElementById("btnSubmit");

      if (!getPetugas()) {
        msgEl.textContent = "Sesi login tidak ditemukan, silakan login ulang";
        msgEl.className = "err";
        return;
      }

      if (!nama) {
        msgEl.textContent = "Nama bahan wajib diisi";
        msgEl.className = "err";
        return;
      }

      if (!satuan) {
        msgEl.textContent = "Satuan wajib diisi";
        msgEl.className = "err";
        return;
      }

      let sku = document.getElementById("fSku").value.trim();
      if (!sku) sku = generateSku();

      const data = {
        sku,
        nama,
        kategori: document.getElementById("fKategori").value.trim(),
        stok: Number(document.getElementById("fStokAwal").value) || 0,
        satuan,
        minStok: Number(document.getElementById("fMinStok").value) || 0,
        expired: document.getElementById("fExp").value.trim() || null,
        petugas: getPetugas()
      };

      btn.disabled = true;
      msgEl.textContent = `Menyimpan ${sku}...`;
      msgEl.className = "";

      try {
        const result = await apiRequest("/api/bahan", {
          method: "POST",
          body: JSON.stringify(data)
        });

        msgEl.textContent = result.message || "Bahan berhasil ditambahkan";
        msgEl.className = "ok";

        document.getElementById("fNama").value = "";
        document.getElementById("fKategori").value = "";
        document.getElementById("fSatuan").value = "";
        document.getElementById("fStokAwal").value = "";
        document.getElementById("fMinStok").value = "";
        document.getElementById("fExp").value = "";
        document.getElementById("fSku").value = "";
        document.getElementById("scanMsg").textContent = "";

        await loadBahan();
      } catch (err) {
        console.error(err);
        msgEl.textContent = err.message || "Gagal menyimpan bahan";
        msgEl.className = "err";
      } finally {
        btn.disabled = false;
      }
    });

    loadBahan();
  </script>
</Layout>
