---

import Layout from "../layouts/Layout.astro";

---

<Layout active="riwayat">  <div class="card"><div class="filterRow">
  <button class="filterBtn active" data-tipe="all">
    Semua
  </button>

  <button class="filterBtn" data-tipe="Masuk">
    Masuk
  </button>

  <button class="filterBtn" data-tipe="Keluar">
    Keluar
  </button>

  <button class="filterBtn" data-tipe="Rusak-Expired">
    Rusak/Exp
  </button>
</div>


<div class="dateRow">

  <div>
    <label for="startDate">
      Dari tanggal
    </label>

    <input
      type="date"
      id="startDate"
    />
  </div>


  <div>
    <label for="endDate">
      Sampai tanggal
    </label>

    <input
      type="date"
      id="endDate"
    />
  </div>

</div>


<button
  id="btnResetDate"
  class="btn-reset"
  type="button"
>
  ✕ Hapus filter tanggal
</button>

  </div>  <div class="card"><h2 style="margin-bottom:12px;">
  📝 Riwayat Transaksi
</h2>

<div id="riwayatList">
  Memuat...
</div>

  </div>  <style is:global>

    .filterRow {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .filterBtn {
      flex: 1;
      min-width: 70px;
      min-height: 48px;
      padding: 10px 4px;
      border: 2px solid transparent;
      border-radius: 10px;
      font-size: .8rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform .15s, box-shadow .15s, background .15s;
    }

    .filterBtn[data-tipe="all"]{background:#e3f2fd;color:#0d47a1;border-color:#90caf9}
    .filterBtn[data-tipe="Masuk"]{background:#e8f5e9;color:#1b5e20;border-color:#a5d6a7}
    .filterBtn[data-tipe="Keluar"]{background:#fff3e0;color:#9a4d00;border-color:#ffcc80}
    .filterBtn[data-tipe="Rusak-Expired"]{background:#ffebee;color:#a51d2d;border-color:#ef9a9a}
    .filterBtn.active{transform:translateY(-2px) scale(1.03);box-shadow:0 0 0 3px #fff,0 0 0 6px currentColor,0 4px 10px #0002}
    .filterBtn[data-tipe="all"].active{background:#1565c0;color:#fff;border-color:#0d47a1}
    .filterBtn[data-tipe="Masuk"].active{background:#2e7d32;color:#fff;border-color:#1b5e20}
    .filterBtn[data-tipe="Keluar"].active{background:#ef8f00;color:#fff;border-color:#b45f00}
    .filterBtn[data-tipe="Rusak-Expired"].active{background:#c62828;color:#fff;border-color:#8e0000}
    .filterBtn:focus-visible,.btn-reset:focus-visible,.btnUndo:focus-visible{outline:3px solid #1565c0;outline-offset:3px}


    .dateRow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
    }


    .dateRow label {
      display: block;
      font-size: .72rem;
      color: #8a7566;
      margin-bottom: 4px;
    }


    .dateRow input {
      width: 100%;
      box-sizing: border-box;
      padding: 8px 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #fafafa;
      font-size: .85rem;
    }


    .btn-reset {
      width: 100%;
      margin-top: 10px;
      padding: 10px;
      border: 2px solid #90a4ae;
      background: #eceff1;
      color: #37474f;
      border-radius: 8px;
      font-size: .78rem;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-reset:active{transform:translateY(1px)}


    .trxItem {
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }


    .trxItem:last-child {
      border-bottom: none;
    }


    .trxItem.cancelled {
      opacity: .45;
    }


    .trxTop {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }


    .trxNama {
      font-weight: 600;
      font-size: .92rem;
    }


    .trxMeta {
      font-size: .75rem;
      color: #8a7566;
      margin-top: 2px;
    }


    .trxStok {
      font-size: .8rem;
      color: #4a2f22;
      margin-top: 5px;
    }


    .trxTag {
      font-size: .7rem;
      padding: 3px 9px;
      border-radius: 20px;
      white-space: nowrap;
      font-weight: 600;
    }


    .trxTag.Masuk {
      background: #e3f2e3;
      color: #2e7d32;
    }


    .trxTag.Keluar {
      background: #fdecd2;
      color: #b5651d;
    }


    .trxTag.Rusak-Expired {
      background: #fbdcdc;
      color: #b52a2a;
    }


    .btnUndo {
      margin-top: 8px;
      font-size: .75rem;
      padding: 6px 12px;
      border: 1px solid #c62828;
      color: #c62828;
      background: #fff;
      border-radius: 8px;
      cursor: pointer;
    }


    .btnUndo:disabled {
      opacity: .4;
      cursor: wait;
    }


    .cancelledTag {
      font-size: .7rem;
      color: #c62828;
      font-weight: 600;
      margin-top: 6px;
    }


    .emptyState {
      color: #8a7566;
      font-size: .85rem;
    }


    .errorState {
      color: #c62828;
      font-size: .85rem;
    }


    @media (max-width: 420px) {

      .dateRow {
        grid-template-columns: 1fr;
      }

    }

  </style>  <script>

    const API_URL =
      import.meta.env.PUBLIC_API_URL || "https://gudang-roti-boss-worker.masbamganteng.workers.dev";


    let currentFilter = "all";

    let allTransaksi = [];


    // ==========================================================
    // FILTER TIPE
    // ==========================================================

    document
      .querySelectorAll(".filterBtn")
      .forEach(btn => {

        btn.addEventListener("click", () => {

          document
            .querySelectorAll(".filterBtn")
            .forEach(b =>
              b.classList.remove("active")
            );

          btn.classList.add("active");

          currentFilter =
            btn.dataset.tipe || "all";

          renderRiwayat();

        });

      });


    // ==========================================================
    // FILTER TANGGAL
    // ==========================================================

    document
      .getElementById("startDate")
      .addEventListener(
        "change",
        renderRiwayat
      );


    document
      .getElementById("endDate")
      .addEventListener(
        "change",
        renderRiwayat
      );


    // ==========================================================
    // RESET FILTER TANGGAL
    // ==========================================================

    document
      .getElementById("btnResetDate")
      .addEventListener("click", () => {

        document
          .getElementById("startDate")
          .value = "";

        document
          .getElementById("endDate")
          .value = "";

        renderRiwayat();

      });


    // ==========================================================
    // ESCAPE HTML
    // ==========================================================

    function esc(value) {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }

    function formatJakartaTime(value) {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value || "-");
      return date.toLocaleString("id-ID", {
        timeZone: "Asia/Jakarta",
        dateStyle: "short",
        timeStyle: "medium"
      });
    }

    function jakartaDateKey(value) {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value || "").slice(0, 10);
      return date.toLocaleString("sv-SE", { timeZone: "Asia/Jakarta" }).slice(0, 10);
    }


    // ==========================================================
    // AMBIL ID TRANSAKSI
    // ==========================================================

    function getId(t) {

      return (
        t.id_transaksi ??
        t.idTransaksi ??
        ""
      );

    }


    // ==========================================================
    // AMBIL STOK LAMA
    // ==========================================================

    function getStokLama(t) {

      return (
        t.stokLama ??
        t.stok_lama ??
        t.stokAwal ??
        t.stok_awal ??
        ""
      );

    }


    // ==========================================================
    // AMBIL STOK AKHIR
    // ==========================================================

    function getStokAkhir(t) {

      return (
        t.stokAkhir ??
        t.stok_akhir ??
        ""
      );

    }


    // ==========================================================
    // RENDER
    // ==========================================================

    function renderRiwayat() {

      const el =
        document.getElementById(
          "riwayatList"
        );


      const start =
        document.getElementById(
          "startDate"
        ).value;


      const end =
        document.getElementById(
          "endDate"
        ).value;


      let data =
        allTransaksi.filter(t => {

          if (
            currentFilter !== "all" &&
            t.tipe !== currentFilter
          ) {

            return false;

          }


          const tanggal =
                          jakartaDateKey(t.timestamp);


          if (
            start &&
            tanggal < start
          ) {

            return false;

          }


          if (
            end &&
            tanggal > end
          ) {

            return false;

          }


          return true;

        });


      data =
        data.slice(0, 50);


      if (!data.length) {

        el.innerHTML = `
          <p class="emptyState">
            Gak ada transaksi di rentang ini.
          </p>
        `;

        return;

      }


      el.innerHTML =
        data.map(t => {

          const id =
            getId(t);


          const keterangan =
            String(
              t.keterangan || ""
            );


          const cancelled =
            keterangan.includes(
              "[DIBATALKAN]"
            );


          const stokLama =
            getStokLama(t);


          const stokAkhir =
            getStokAkhir(t);


          return `

            <div
              class="trxItem ${
                cancelled
                  ? "cancelled"
                  : ""
              }"
            >

              <div class="trxTop">

                <div>

                  <div class="trxNama">
                    ${esc(t.nama_bahan ?? t.nama ?? t.sku ?? "-")}
                  </div>


                  <div class="trxMeta">
                    ${esc(formatJakartaTime(t.timestamp))}
                    ${
                      t.petugas
                        ? ` | ${esc(t.petugas)}`
                        : ""
                    }
                  </div>

                </div>


                <span
                  class="trxTag ${esc(t.tipe)}"
                >
                  ${esc(t.tipe)}
                </span>

              </div>


              <div class="trxStok">

                Qty:
                ${esc(t.qty)}
                ${esc(t.satuan)}

                |

                Stok:
                ${esc(stokLama)}
                →
                ${esc(stokAkhir)}

              </div>


              ${
                keterangan
                  ? `
                    <div class="trxMeta">
                      ${esc(keterangan)}
                    </div>
                  `
                  : ""
              }


              ${
                cancelled

                  ? `
                    <div class="cancelledTag">
                      ✕ Transaksi ini sudah dibatalkan
                    </div>
                  `

                  : `
                    <button
                      type="button"
                      class="btnUndo"
                      data-id="${esc(id)}"
                    >
                      ↩️ Batalkan transaksi ini
                    </button>
                  `
              }

            </div>

          `;

        }).join("");


      el
        .querySelectorAll(".btnUndo")
        .forEach(btn => {

          btn.addEventListener(
            "click",
            () => {

              undoTransaksi(
                btn.dataset.id,
                btn
              );

            }
          );

        });

    }


    // ==========================================================
    // LOAD DARI D1
    // ==========================================================

    async function loadRiwayat() {

      const el =
        document.getElementById(
          "riwayatList"
        );


      el.innerHTML =
        "Memuat...";


      try {

        if (!API_URL) {

          throw new Error(
            "PUBLIC_API_URL belum diset"
          );

        }


        const res =
          await fetch(
            `${API_URL}/api/transaksi`
          );


        const result =
          await res.json();


        if (
          !res.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Gagal mengambil transaksi"
          );

        }


        allTransaksi =
          Array.isArray(
            result.data
          )
            ? result.data
            : [];


        renderRiwayat();

      } catch (err) {

        console.error(err);

        el.innerHTML = `
          <p class="errorState">
            Gagal memuat riwayat.
            ${esc(err.message)}
          </p>
        `;

      }

    }


    // ==========================================================
    // BATAL TRANSAKSI
    // ==========================================================

    async function undoTransaksi(
      id,
      btn
    ) {

      if (!id) {

        alert(
          "ID transaksi tidak ditemukan."
        );

        return;

      }


      if (
        !confirm(
          "Batalkan transaksi ini?\n\n" +
          "Stok akan dikembalikan " +
          "ke kondisi sebelum transaksi."
        )
      ) {

        return;

      }


      btn.disabled = true;

      btn.textContent =
        "Membatalkan...";


      try {

        const res =
          await fetch(
            `${API_URL}/api/transaksi`,
            {
              method: "DELETE",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body: JSON.stringify({
                idTransaksi: id
              })

            }
          );


        const result =
          await res.json();


        if (
          !res.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Gagal membatalkan transaksi"
          );

        }


        alert(
          result.message ||
          "Transaksi berhasil dibatalkan."
        );


        await loadRiwayat();

      } catch (err) {

        console.error(err);

        alert(
          "Gagal: " +
          (
            err.message ||
            "Server error"
          )
        );


        btn.disabled = false;

        btn.textContent =
          "↩️ Batalkan transaksi ini";

      }

    }


    // ==========================================================
    // START
    // ==========================================================

    loadRiwayat();

  </script></Layout>