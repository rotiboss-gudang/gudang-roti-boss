---
import Layout from "../layouts/Layout.astro";
---

<Layout active="input">
  <div class="card">
    <div class="tipeRow">
      <button type="button" class="tipeBtn active" data-tipe="Masuk">📥 Masuk</button>
      <button type="button" class="tipeBtn" data-tipe="Keluar">📤 Keluar</button>
      <button type="button" class="tipeBtn" data-tipe="Rusak-Expired">🗑️ Rusak/Exp</button>
    </div>
  </div>

  <div class="card">
    <div class="petugasBox">👤 Petugas: <strong id="petugasName">-</strong></div>
    <label>Bahan Baku</label>

    <div class="searchWrap">
      <input type="text" id="fBahanSearch" placeholder="Ketik nama, atau tap buat lihat semua..." autocomplete="off" />
      <div id="fBahanResults" class="searchResults hidden"></div>
    </div>

    <button type="button" id="btnScan" class="btn-scan">📷 Scan Barcode</button>
    <div id="reader" class="hidden"></div>
    <div id="scanMsg" class="scanMsg"></div>
    <div id="stokInfo" class="stokInfo"></div>

    <label id="expLabel">Tanggal Expired</label>
    <input type="date" id="fExp" />

    <label>Jumlah</label>
    <div class="qtyRow">
      <button type="button" id="qtyMinus" class="qtyBtn">−</button>
      <input type="number" id="fQty" value="1" min="0.1" step="0.1" />
      <button type="button" id="qtyPlus" class="qtyBtn">+</button>
    </div>

    <label>Keterangan (opsional)</label>
    <input type="text" id="fKeterangan" placeholder="misal: retur supplier, keluar manual" />

    <div id="formMsg"></div>
    <button type="button" id="btnSubmit" class="btn-primary">Simpan Transaksi</button>
  </div>

  <style is:global>
    .tipeRow{display:flex;gap:8px}.tipeBtn{flex:1;min-height:52px;padding:12px 4px;border:2px solid transparent;border-radius:12px;font-size:.85rem;font-weight:700;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s}.tipeBtn[data-tipe="Masuk"]{background:#e8f5e9;color:#1b5e20;border-color:#a5d6a7}.tipeBtn[data-tipe="Keluar"]{background:#fff3e0;color:#9a4d00;border-color:#ffcc80}.tipeBtn[data-tipe="Rusak-Expired"]{background:#ffebee;color:#a51d2d;border-color:#ef9a9a}.tipeBtn.active{transform:translateY(-2px) scale(1.03);box-shadow:0 0 0 3px #fff,0 0 0 6px currentColor,0 5px 12px #0002}.tipeBtn[data-tipe="Masuk"].active{background:#2e7d32;color:#fff;border-color:#1b5e20}.tipeBtn[data-tipe="Keluar"].active{background:#ef8f00;color:#fff;border-color:#b45f00}.tipeBtn[data-tipe="Rusak-Expired"].active{background:#c62828;color:#fff;border-color:#8e0000}.tipeBtn:focus-visible,.qtyBtn:focus-visible,.btn-primary:focus-visible,.btn-scan:focus-visible{outline:3px solid #1565c0;outline-offset:3px}
    .petugasBox{background:#f9f5f0;border-radius:10px;padding:10px 12px;font-size:.9rem;margin-bottom:4px}label{display:block;font-size:.8rem;color:#8a7566;margin:12px 0 4px}
    input[type=text],input[type=number],input[type=date]{width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:10px;background:#fafafa;box-sizing:border-box}
    .searchWrap{position:relative}.searchResults{position:relative;margin-top:4px;max-height:240px;overflow-y:auto;border:1px solid #ddd;border-radius:10px;background:#fff;z-index:20}.hidden{display:none!important}
    .searchItem{padding:10px 12px;border-bottom:1px solid #f0f0f0;font-size:.88rem;cursor:pointer}.searchItem:last-child{border-bottom:none}.searchItem .nama{font-weight:600;color:#4a2f22}.searchItem .sub{font-size:.75rem;color:#8a7566;margin-top:2px}.searchItem:active{background:#f2ece4}.searchEmpty{padding:12px;font-size:.82rem;color:#8a7566;text-align:center}
    .btn-scan{width:100%;padding:12px;border:2px dashed #5c3d2e;background:#fff;color:#5c3d2e;border-radius:12px;font-weight:600;margin-top:8px}#reader{width:100%!important;border-radius:16px;overflow:hidden;margin-top:10px}#reader video{border-radius:16px}.scanMsg{font-size:.8rem;margin-top:6px}.stokInfo{font-size:.8rem;color:#8a7566;margin-top:8px}
    .qtyRow{display:flex;align-items:center;gap:10px}.qtyRow input{text-align:center;flex:1;font-size:1.05rem;font-weight:700}.qtyBtn{width:48px;height:48px;flex:0 0 48px;border-radius:50%;font-size:1.45rem;font-weight:800;line-height:1;cursor:pointer;transition:transform .12s,box-shadow .12s}.qtyBtn:active{transform:scale(.94)}#qtyMinus{background:#ffebee;color:#b71c1c;border:2px solid #e57373;box-shadow:0 2px 5px #b71c1c33}#qtyPlus{background:#e8f5e9;color:#1b5e20;border:2px solid #66bb6a;box-shadow:0 2px 5px #1b5e2033}
    .btn-primary{width:100%;padding:14px;background:#1565c0;color:#fff;border:2px solid #0d47a1;border-radius:12px;font-weight:800;margin-top:12px;box-shadow:0 3px 8px #1565c044}.btn-primary:active{transform:translateY(1px)}.btn-primary:disabled{opacity:.6}#formMsg{font-size:.85rem;margin-top:10px}#formMsg.ok{color:#2e7d32}#formMsg.err{color:#c62828}
  </style>

  <script src="https://unpkg.com/html5-qrcode" is:inline></script>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "https://gudang-roti-boss-worker.masbamganteng.workers.dev";
    let currentTipe = "Masuk";
    let allBahan = [];
    let selectedSku = "";
    let html5QrCode = null;
    let scanning = false;

    const $ = id => document.getElementById(id);

    function getPetugas() {
      try {
        const data = JSON.parse(localStorage.getItem("gudangPetugas") || "null");
        return data?.nama || "";
      } catch {
        return "";
      }
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function showMessage(text, type = "") {
      $("formMsg").textContent = text;
      $("formMsg").className = type;
    }

    // ========================================================
    // MASTER BAHAN — LANGSUNG DARI D1
    // ========================================================
    async function loadBahan() {
      try {
        const response = await fetch(`${API_URL}/api/bahan?_=${Date.now()}`, {
          method: "GET",
          cache: "no-store",
          headers: {
            Accept: "application/json"
          }
        });

        const result = await response.json();

        if (!response.ok || !result.success || !Array.isArray(result.data)) {
          throw new Error(result.message || `HTTP ${response.status}`);
        }

        allBahan = result.data
          .map(item => ({
            sku: String(item.sku || "").trim(),
            nama: String(item.nama || "").trim(),
            kategori: String(item.kategori || "").trim(),
            stok: Number(item.stok) || 0,
            satuan: String(item.satuan || "").trim(),
            minStok: Number(item.minStok) || 0,
            expired: item.expired || null
          }))
          .filter(item => item.sku && item.nama);

        console.log("INPUT — MASTER D1:", allBahan);
        updateStokInfo();
        return true;
      } catch (error) {
        console.error("Gagal mengambil master bahan:", error);
        allBahan = [];
        return false;
      }
    }

    function renderResults() {
      const query = $("fBahanSearch").value.trim().toLowerCase();
      const list = query
        ? allBahan.filter(item =>
            item.nama.toLowerCase().includes(query) ||
            item.sku.toLowerCase().includes(query)
          )
        : allBahan;

      const results = $("fBahanResults");

      if (!list.length) {
        results.innerHTML = '<div class="searchEmpty">Gak ada bahan yang cocok.</div>';
      } else {
        results.innerHTML = list.map(item => `
          <div class="searchItem" data-sku="${escapeHtml(item.sku)}">
            <div class="nama">${escapeHtml(item.nama)}</div>
            <div class="sub">${escapeHtml(item.sku)} | Stok: ${item.stok} ${escapeHtml(item.satuan)}</div>
          </div>
        `).join("");

        results.querySelectorAll(".searchItem").forEach(element => {
          element.addEventListener("click", () => selectBahan(element.dataset.sku));
        });
      }

      results.classList.remove("hidden");
    }

    async function openBahanList() {
      await loadBahan();
      renderResults();
    }

    function selectBahan(sku) {
      const item = allBahan.find(bahan => bahan.sku === sku);
      if (!item) return;

      selectedSku = item.sku;
      $("fBahanSearch").value = item.nama;
      $("fBahanResults").classList.add("hidden");
      updateStokInfo();
    }

    function updateStokInfo() {
      const item = allBahan.find(bahan => bahan.sku === selectedSku);
      $("stokInfo").textContent = item
        ? `Stok saat ini: ${item.stok} ${item.satuan} (Min: ${item.minStok})`
        : "";
    }

    // ========================================================
    // PETUGAS
    // ========================================================
    $("petugasName").textContent = getPetugas() || "-";

    // ========================================================
    // TIPE TRANSAKSI
    // ========================================================
    function setTipe(tipe) {
      currentTipe = tipe;
      document.querySelectorAll(".tipeBtn").forEach(button => {
        button.classList.toggle("active", button.dataset.tipe === tipe);
      });

      const masuk = tipe === "Masuk";
      $("expLabel").style.display = masuk ? "block" : "none";
      $("fExp").style.display = masuk ? "block" : "none";
      if (!masuk) $("fExp").value = "";
    }

    document.querySelectorAll(".tipeBtn").forEach(button => {
      button.addEventListener("click", () => setTipe(button.dataset.tipe));
    });

    // ========================================================
    // SEARCH / DROPDOWN
    // ========================================================
    $("fBahanSearch").addEventListener("focus", openBahanList);
    $("fBahanSearch").addEventListener("click", openBahanList);

    $("fBahanSearch").addEventListener("input", () => {
      selectedSku = "";
      updateStokInfo();
      renderResults();
    });

    document.addEventListener("click", event => {
      if (!event.target.closest(".searchWrap")) {
        $("fBahanResults").classList.add("hidden");
      }
    });

    // ========================================================
    // QTY
    // ========================================================
    $("qtyMinus").addEventListener("click", () => {
      $("fQty").value = Math.max(0.1, (Number($("fQty").value) || 1) - 1);
    });

    $("qtyPlus").addEventListener("click", () => {
      $("fQty").value = (Number($("fQty").value) || 0) + 1;
    });

    // ========================================================
    // BARCODE
    // ========================================================
    async function stopScanner() {
      if (html5QrCode) {
        try { await html5QrCode.stop(); } catch {}
        try { await html5QrCode.clear(); } catch {}
      }
      $("reader").classList.add("hidden");
      $("btnScan").textContent = "📷 Scan Barcode";
      scanning = false;
    }

    $("btnScan").addEventListener("click", async () => {
      if (scanning) {
        await stopScanner();
        return;
      }

      await loadBahan();
      $("reader").classList.remove("hidden");
      $("btnScan").textContent = "⏹️ Stop Scan";
      $("scanMsg").textContent = "";

      if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");

      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: 220 },
          decodedText => {
            const code = decodedText.trim().toLowerCase();
            const item = allBahan.find(bahan => bahan.sku.toLowerCase() === code);

            if (!item) {
              $("scanMsg").style.color = "#c62828";
              $("scanMsg").textContent = `Barcode "${decodedText}" tidak ditemukan di daftar bahan.`;
              return;
            }

            selectBahan(item.sku);
            $("scanMsg").style.color = "#2e7d32";
            $("scanMsg").textContent = `Ketemu: ${item.nama}`;
            stopScanner();
          },
          () => {}
        );

        scanning = true;
        $("scanMsg").style.color = "#8a7566";
        $("scanMsg").textContent = "Kamera aktif, arahkan ke barcode...";
      } catch (error) {
        console.error(error);
        $("scanMsg").style.color = "#c62828";
        $("scanMsg").textContent = "Gagal akses kamera";
        await stopScanner();
      }
    });

    // ========================================================
    // SIMPAN TRANSAKSI
    // ========================================================
    $("btnSubmit").addEventListener("click", async () => {
      const button = $("btnSubmit");
      const petugas = getPetugas();
      const item = allBahan.find(bahan => bahan.sku === selectedSku);
      const qty = Number($("fQty").value);

      if (!petugas) return showMessage("Sesi login gak valid, coba login ulang", "err");
      if (!item) return showMessage("Pilih bahan dulu", "err");
      if (!Number.isFinite(qty) || qty <= 0) return showMessage("Jumlah harus lebih dari 0", "err");

      const payload = {
        tipe: currentTipe,
        sku: item.sku,
        qty,
        satuan: item.satuan,
        keterangan: $("fKeterangan").value.trim(),
        petugas,
        exp: currentTipe === "Masuk" ? $("fExp").value : ""
      };

      button.disabled = true;
      showMessage("Menyimpan...");

      try {
        const response = await fetch(`${API_URL}/api/transaksi`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Transaksi gagal");
        }

        showMessage(result.message || "Transaksi berhasil", "ok");
        $("fQty").value = "1";
        $("fKeterangan").value = "";
        $("fExp").value = "";
        $("fBahanSearch").value = "";
        $("fBahanResults").classList.add("hidden");
        selectedSku = "";

        await loadBahan();
      } catch (error) {
        console.error(error);
        showMessage(error.message || "Gagal terhubung ke server", "err");
      } finally {
        button.disabled = false;
      }
    });

    setTipe("Masuk");
    loadBahan();
  </script>
</Layout>
