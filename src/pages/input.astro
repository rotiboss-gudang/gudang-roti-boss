---
import Layout from "../layouts/Layout.astro";
---

<Layout active="input">
  <div class="card">
    <div class="tipeRow">
      <button type="button" class="tipeBtn active" data-tipe="Masuk">📥 Masuk</button>
      <button type="button" class="tipeBtn" data-tipe="Keluar">📤 Keluar</button>
      <button type="button" class="tipeBtn" data-tipe="Rusak-Expired">🗑️ Rusak/Exp</button>
    </div>
  </div>

  <div class="card">
    <div class="petugasBox">👤 Petugas: <strong id="petugasName">-</strong></div>

    <label>Bahan Baku</label>
    <div class="searchWrap">
      <input type="text" id="fBahanSearch" placeholder="Ketik nama, atau tap buat lihat semua..." autocomplete="off" />
      <div id="fBahanResults" class="searchResults hidden"></div>
    </div>

    <button type="button" id="btnScan" class="btn-scan">📷 Scan Barcode</button>
    <div id="reader" class="hidden"></div>
    <div id="scanMsg" class="scanMsg"></div>
    <div id="stokInfo" class="stokInfo"></div>

    <label id="expLabel" style="display:block;">Tanggal Expired</label>
    <input type="date" id="fExp" style="display:block;" />

    <label>Jumlah</label>
    <div class="qtyRow">
      <button type="button" id="qtyMinus" class="qtyBtn">−</button>
      <input type="number" id="fQty" value="1" min="0.1" step="0.1" />
      <button type="button" id="qtyPlus" class="qtyBtn">+</button>
    </div>

    <label>Keterangan (opsional)</label>
    <input type="text" id="fKeterangan" placeholder="misal: retur supplier, produksi harian" />

    <div id="formMsg"></div>
    <button type="button" id="btnSubmit" class="btn-primary">Simpan Transaksi</button>
  </div>

  <style is:global>
    .tipeRow{display:flex;gap:8px}.tipeBtn{flex:1;padding:12px 4px;border:2px solid #eee;background:#fff;border-radius:12px;font-size:.85rem;font-weight:600;color:#8a7566}.tipeBtn.active{border-color:#5c3d2e;color:#5c3d2e;background:#f2ece4}
    .petugasBox{background:#f9f5f0;border-radius:10px;padding:10px 12px;font-size:.9rem}label{display:block;font-size:.8rem;color:#8a7566;margin:12px 0 4px}
    input[type=text],input[type=number],input[type=date]{width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:10px;background:#fafafa;box-sizing:border-box}
    .searchWrap{position:relative}.searchResults{position:relative;margin-top:4px;max-height:240px;overflow-y:auto;border:1px solid #ddd;border-radius:10px;background:#fff;z-index:20}.hidden{display:none!important}
    .searchItem{padding:10px 12px;border-bottom:1px solid #f0f0f0;cursor:pointer}.searchItem:last-child{border-bottom:none}.searchItem .nama{font-weight:600;color:#4a2f22}.searchItem .sub{font-size:.75rem;color:#8a7566;margin-top:2px}.searchItem:active{background:#f2ece4}.searchEmpty{padding:12px;text-align:center;color:#8a7566;font-size:.82rem}
    .btn-scan{width:100%;padding:12px;border:2px dashed #5c3d2e;background:#fff;color:#5c3d2e;border-radius:12px;font-weight:600;margin-top:8px}#reader{width:100%!important;border-radius:16px;overflow:hidden;margin-top:10px}#reader video{border-radius:16px}.scanMsg,.stokInfo{font-size:.8rem;margin-top:6px;color:#8a7566}
    .qtyRow{display:flex;align-items:center;gap:10px}.qtyRow input{text-align:center;flex:1}.qtyBtn{width:44px;height:44px;border-radius:50%;border:0;background:#f2ece4;color:#5c3d2e;font-size:1.3rem;font-weight:700}
    .btn-primary{width:100%;padding:14px;background:#5c3d2e;color:#fff;border:0;border-radius:12px;font-weight:600;margin-top:12px}.btn-primary:disabled{opacity:.6}#formMsg{font-size:.85rem;margin-top:10px}#formMsg.ok{color:#2e7d32}#formMsg.err{color:#c62828}
  </style>

  <script src="https://unpkg.com/html5-qrcode" is:inline></script>
  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL;
    let currentTipe = "Masuk";
    let allBahan = [];
    let selectedSku = "";
    let scanner = null;
    let scanning = false;
    let requestSeq = 0;

    const $ = id => document.getElementById(id);

    function getPetugas() {
      try {
        return JSON.parse(localStorage.getItem("gudangPetugas") || "null")?.nama || "";
      } catch {
        return "";
      }
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function showMessage(text, type = "") {
      $("formMsg").textContent = text;
      $("formMsg").className = type;
    }

    // ========================================================
    // MASTER BAHAN — SELALU BACA LANGSUNG DARI D1
    // ========================================================
    async function loadBahan() {
      const seq = ++requestSeq;

      try {
        const res = await fetch(`${API_URL}/api/bahan?_=${Date.now()}`, {
          method: "GET",
          cache: "no-store",
          headers: {
            Accept: "application/json",
            "Cache-Control": "no-cache, no-store, max-age=0"
          }
        });

        const result = await res.json();

        if (!res.ok || !result.success || !Array.isArray(result.data)) {
          throw new Error(result.message || `HTTP ${res.status}`);
        }

        // Abaikan response lama kalau ada request yang datang bersamaan.
        if (seq !== requestSeq) return false;

        allBahan = result.data
          .map(p => ({
            sku: String(p.sku || "").trim(),
            nama: String(p.nama || "").trim(),
            kategori: String(p.kategori || "").trim(),
            stok: Number(p.stok) || 0,
            satuan: String(p.satuan || "").trim(),
            minStok: Number(p.minStok) || 0,
            expired: p.expired || null
          }))
          .filter(p => p.sku && p.nama);

        console.log("INPUT /api/bahan D1:", allBahan);
        updateStokInfo();
        return true;
      } catch (err) {
        console.error("Gagal load bahan:", err);
        return false;
      }
    }

    function renderResults() {
      const q = $("fBahanSearch").value.trim().toLowerCase();
      const list = q
        ? allBahan.filter(p =>
            p.nama.toLowerCase().includes(q) ||
            p.sku.toLowerCase().includes(q)
          )
        : allBahan;

      const el = $("fBahanResults");

      if (!list.length) {
        el.innerHTML = `<div class="searchEmpty">Gak ada bahan yang cocok.</div>`;
      } else {
        el.innerHTML = list.map(p => `
          <div class="searchItem" data-sku="${escapeHtml(p.sku)}">
            <div class="nama">${escapeHtml(p.nama)}</div>
            <div class="sub">${escapeHtml(p.sku)} | Stok: ${p.stok} ${escapeHtml(p.satuan)}</div>
          </div>
        `).join("");

        el.querySelectorAll(".searchItem").forEach(item => {
          item.addEventListener("click", () => selectBahan(item.dataset.sku));
        });
      }

      el.classList.remove("hidden");
    }

    async function openBahanDropdown() {
      // Ini sengaja fetch ulang. Jadi bahan baru yang baru ditambahkan
      // tidak bergantung pada array lama di browser.
      await loadBahan();
      renderResults();
    }

    function selectBahan(sku) {
      const p = allBahan.find(x => x.sku === sku);
      if (!p) return;

      selectedSku = p.sku;
      $("fBahanSearch").value = p.nama;
      $("fBahanResults").classList.add("hidden");
      updateStokInfo();
    }

    function updateStokInfo() {
      const p = allBahan.find(x => x.sku === selectedSku);
      $("stokInfo").textContent = p
        ? `Stok saat ini: ${p.stok} ${p.satuan} (Min: ${p.minStok})`
        : "";
    }

    // ========================================================
    // PETUGAS
    // ========================================================
    $("petugasName").textContent = getPetugas() || "-";

    // ========================================================
    // TIPE TRANSAKSI
    // ========================================================
    function setTipe(tipe) {
      currentTipe = tipe;

      document.querySelectorAll(".tipeBtn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.tipe === tipe);
      });

      const isMasuk = tipe === "Masuk";
      $("expLabel").style.display = isMasuk ? "block" : "none";
      $("fExp").style.display = isMasuk ? "block" : "none";

      if (!isMasuk) $("fExp").value = "";
    }

    document.querySelectorAll(".tipeBtn").forEach(btn => {
      btn.addEventListener("click", async () => {
        setTipe(btn.dataset.tipe);
        // Tidak perlu menunggu user membuka dropdown untuk refresh master.
        await loadBahan();
      });
    });

    // ========================================================
    // SEARCH / DROPDOWN
    // ========================================================
    $("fBahanSearch").addEventListener("focus", openBahanDropdown);
    $("fBahanSearch").addEventListener("click", openBahanDropdown);

    $("fBahanSearch").addEventListener("input", async () => {
      selectedSku = "";
      updateStokInfo();

      // Tampilkan data yang sudah ada dulu supaya responsif.
      renderResults();

      // Setelah itu sinkronkan lagi dengan D1.
      await loadBahan();
      renderResults();
    });

    document.addEventListener("click", e => {
      if (!e.target.closest(".searchWrap")) {
        $("fBahanResults").classList.add("hidden");
      }
    });

    // ========================================================
    // QTY
    // ========================================================
    $("qtyMinus").addEventListener("click", () => {
      $("fQty").value = Math.max(0.1, (Number($("fQty").value) || 1) - 1);
    });

    $("qtyPlus").addEventListener("click", () => {
      $("fQty").value = (Number($("fQty").value) || 0) + 1;
    });

    // ========================================================
    // BARCODE
    // ========================================================
    async function stopScanner() {
      if (scanner) {
        try { await scanner.stop(); } catch {}
        try { await scanner.clear(); } catch {}
      }

      $("reader").classList.add("hidden");
      $("btnScan").textContent = "📷 Scan Barcode";
      scanning = false;
    }

    $("btnScan").addEventListener("click", async () => {
      if (scanning) {
        await stopScanner();
        return;
      }

      await loadBahan();

      $("reader").classList.remove("hidden");
      $("btnScan").textContent = "⏹️ Stop Scan";
      $("scanMsg").textContent = "";

      scanner = new Html5Qrcode("reader");

      try {
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: 220 },
          decodedText => {
            const code = decodedText.trim().toLowerCase();
            const match = allBahan.find(p => p.sku.toLowerCase() === code);

            if (!match) {
              $("scanMsg").textContent = `Barcode "${decodedText}" tidak ditemukan di daftar bahan.`;
              return;
            }

            selectBahan(match.sku);
            $("scanMsg").style.color = "#2e7d32";
            $("scanMsg").textContent = `Ketemu: ${match.nama}`;
            stopScanner();
          },
          () => {}
        );

        scanning = true;
        $("scanMsg").style.color = "#8a7566";
        $("scanMsg").textContent = "Kamera aktif, arahkan ke barcode...";
      } catch (err) {
        console.error(err);
        $("scanMsg").style.color = "#c62828";
        $("scanMsg").textContent = "Gagal akses kamera";
        await stopScanner();
      }
    });

    // ========================================================
    // SIMPAN TRANSAKSI
    // ========================================================
    $("btnSubmit").addEventListener("click", async () => {
      const btn = $("btnSubmit");
      const user = getPetugas();
      const p = allBahan.find(x => x.sku === selectedSku);
      const qty = Number($("fQty").value);

      if (!user) return showMessage("Sesi login gak valid, coba login ulang", "err");
      if (!p) return showMessage("Pilih bahan dulu", "err");
      if (!Number.isFinite(qty) || qty <= 0) return showMessage("Jumlah harus lebih dari 0", "err");

      const payload = {
        tipe: currentTipe,
        sku: p.sku,
        qty,
        satuan: p.satuan,
        keterangan: $("fKeterangan").value.trim(),
        petugas: user,
        exp: currentTipe === "Masuk" ? $("fExp").value : ""
      };

      btn.disabled = true;
      showMessage("Menyimpan...");

      try {
        const res = await fetch(`${API_URL}/api/transaksi`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || "Transaksi gagal");
        }

        showMessage(result.message || "Transaksi berhasil", "ok");
        $("fQty").value = "1";
        $("fKeterangan").value = "";
        $("fExp").value = "";
        $("fBahanSearch").value = "";
        $("fBahanResults").classList.add("hidden");
        selectedSku = "";

        await loadBahan();
      } catch (err) {
        console.error(err);
        showMessage(err.message || "Gagal terhubung ke server", "err");
      } finally {
        btn.disabled = false;
      }
    });

    // ========================================================
    // START
    // ========================================================
    setTipe("Masuk");
    loadBahan();
  </script>
</Layout>
