---
import Layout from "../layouts/Layout.astro";
---

<Layout active="input">
  <div class="card">
    <div class="tipeRow">
      <button class="tipeBtn active" data-tipe="Masuk">📥 Masuk</button>
      <button class="tipeBtn" data-tipe="Keluar">📤 Keluar</button>
      <button class="tipeBtn" data-tipe="Rusak-Expired">🗑️ Rusak/Exp</button>
    </div>
  </div>

  <div class="card">
    <div class="petugasBox">👤 Petugas: <strong id="petugasName">-</strong></div>
    <label>Bahan Baku</label>
    <div class="searchWrap">
      <input type="text" id="fBahanSearch" placeholder="Ketik nama, atau tap buat lihat semua..." autocomplete="off" />
      <div id="fBahanResults" class="searchResults hidden"></div>
    </div>
    <button type="button" id="btnScan" class="btn-scan">📷 Scan Barcode</button>
    <div id="reader" class="hidden"></div>
    <div id="scanMsg" class="scanMsg"></div>
    <div id="stokInfo" class="stokInfo"></div>
    <label id="expLabel">Tanggal Expired</label>
    <input type="date" id="fExp" />
    <label>Jumlah</label>
    <div class="qtyRow"><button type="button" id="qtyMinus" class="qtyBtn">−</button><input type="number" id="fQty" value="1" min="0.1" step="0.1" /><button type="button" id="qtyPlus" class="qtyBtn">+</button></div>
    <label>Keterangan (opsional)</label>
    <input type="text" id="fKeterangan" placeholder="misal: retur supplier, produksi harian" />
    <div id="formMsg"></div>
    <button type="button" id="btnSubmit" class="btn-primary">Simpan Transaksi</button>
  </div>

  <style is:global>
    .tipeRow{display:flex;gap:8px}.tipeBtn{flex:1;padding:12px 4px;border:2px solid #eee;background:#fff;border-radius:12px;font-size:.85rem;font-weight:600;color:#8a7566}.tipeBtn.active{border-color:#5c3d2e;color:#5c3d2e;background:#f2ece4}.petugasBox{background:#f9f5f0;border-radius:10px;padding:10px 12px;font-size:.9rem}label{display:block;font-size:.8rem;color:#8a7566;margin:12px 0 4px}input[type=text],input[type=number],input[type=date]{width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:10px;background:#fafafa;box-sizing:border-box}.searchWrap{position:relative}.searchResults{margin-top:4px;max-height:240px;overflow-y:auto;border:1px solid #ddd;border-radius:10px;background:#fff}.hidden{display:none!important}.searchItem{padding:10px 12px;border-bottom:1px solid #eee;cursor:pointer}.searchItem .nama{font-weight:600;color:#4a2f22}.searchItem .sub{font-size:.75rem;color:#8a7566;margin-top:2px}.searchEmpty{padding:12px;text-align:center;color:#8a7566;font-size:.82rem}.btn-scan{width:100%;padding:12px;border:2px dashed #5c3d2e;background:#fff;color:#5c3d2e;border-radius:12px;font-weight:600;margin-top:8px}#reader{width:100%!important;border-radius:16px;overflow:hidden;margin-top:10px}.scanMsg,.stokInfo{font-size:.8rem;margin-top:6px;color:#8a7566}.qtyRow{display:flex;align-items:center;gap:10px}.qtyRow input{text-align:center;flex:1}.qtyBtn{width:44px;height:44px;border-radius:50%;border:0;background:#f2ece4;color:#5c3d2e;font-size:1.3rem;font-weight:700}.btn-primary{width:100%;padding:14px;background:#5c3d2e;color:#fff;border:0;border-radius:12px;font-weight:600;margin-top:12px}.btn-primary:disabled{opacity:.6}#formMsg{font-size:.85rem;margin-top:10px}#formMsg.ok{color:#2e7d32}#formMsg.err{color:#c62828}
  </style>

  <script src="https://unpkg.com/html5-qrcode" is:inline></script>
  <script>
    const API_URL=import.meta.env.PUBLIC_API_URL;
    let currentTipe="Masuk",allBahan=[],selectedSku="",scanner=null,scanning=false,loading=false;

    const $=id=>document.getElementById(id);
    const petugas=()=>{try{return JSON.parse(localStorage.getItem("gudangPetugas")||"null")?.nama||""}catch{return ""}};
    function msg(text,type=""){$("formMsg").textContent=text;$('formMsg').className=type}
    function esc(v){return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/\"/g,"&quot;").replace(/'/g,"&#039;")}

    async function loadBahan(showError=true){
      if(loading)return; loading=true;
      try{
        const r=await fetch(`${API_URL}/api/bahan`,{cache:"no-store",headers:{Accept:"application/json","Cache-Control":"no-cache"}});
        const j=await r.json();
        if(!r.ok||!j.success||!Array.isArray(j.data))throw Error(j.message||`HTTP ${r.status}`);
        allBahan=j.data.map(p=>({sku:String(p.sku||"").trim(),nama:String(p.nama||"").trim(),stok:Number(p.stok)||0,satuan:String(p.satuan||"").trim(),minStok:Number(p.minStok)||0})).filter(p=>p.sku&&p.nama);
        render();updateStok();console.log("INPUT master D1:",allBahan);
      }catch(e){console.error(e);if(showError)msg("Gagal mengambil daftar bahan dari D1","err")}finally{loading=false}
    }

    function render(){
      const q=$("fBahanSearch").value.trim().toLowerCase();
      const list=!q?allBahan:allBahan.filter(p=>p.nama.toLowerCase().includes(q)||p.sku.toLowerCase().includes(q));
      const el=$("fBahanResults");
      el.innerHTML=list.length?list.map(p=>`<div class="searchItem" data-sku="${esc(p.sku)}"><div class="nama">${esc(p.nama)}</div><div class="sub">${esc(p.sku)} | Stok: ${p.stok} ${esc(p.satuan)}</div></div>`).join(""):"<div class=\"searchEmpty\">Belum ada bahan yang cocok.</div>";
      el.classList.remove("hidden");
      el.querySelectorAll(".searchItem").forEach(x=>x.onclick=()=>select(x.dataset.sku));
    }
    function select(sku){const p=allBahan.find(x=>x.sku===sku);if(!p)return;selectedSku=p.sku;$("fBahanSearch").value=p.nama;$("fBahanResults").classList.add("hidden");updateStok()}
    function updateStok(){const p=allBahan.find(x=>x.sku===selectedSku);$("stokInfo").textContent=p?`Stok saat ini: ${p.stok} ${p.satuan} (Min: ${p.minStok})`:""}
    function setTipe(t){currentTipe=t;document.querySelectorAll(".tipeBtn").forEach(b=>b.classList.toggle("active",b.dataset.tipe===t));const masuk=t==="Masuk";$("expLabel").style.display=masuk?"block":"none";$("fExp").style.display=masuk?"block":"none";if(!masuk)$("fExp").value=""}

    $("petugasName").textContent=petugas()||"-";
    document.querySelectorAll(".tipeBtn").forEach(b=>b.onclick=async()=>{setTipe(b.dataset.tipe);await loadBahan(false)});
    $("fBahanSearch").onfocus=async()=>{await loadBahan(false);render()};
    $("fBahanSearch").onclick=async()=>{await loadBahan(false);render()};
    $("fBahanSearch").oninput=async()=>{selectedSku="";updateStok();await loadBahan(false);render()};
    document.addEventListener("click",e=>{if(!e.target.closest(".searchWrap"))$("fBahanResults").classList.add("hidden")});
    $("qtyMinus").onclick=()=>$("fQty").value=Math.max(.1,(Number($("fQty").value)||1)-1);
    $("qtyPlus").onclick=()=>$("fQty").value=(Number($("fQty").value)||0)+1;

    async function stopScanner(){if(scanner){try{await scanner.stop()}catch{}try{await scanner.clear()}catch{}}$("reader").classList.add("hidden");$("btnScan").textContent="📷 Scan Barcode";scanning=false}
    $("btnScan").onclick=async()=>{
      if(scanning){await stopScanner();return} await loadBahan(false);$("reader").classList.remove("hidden");$("btnScan").textContent="⏹️ Stop Scan";scanner=new Html5Qrcode("reader");
      try{await scanner.start({facingMode:"environment"},{fps:10,qrbox:220},code=>{const p=allBahan.find(x=>x.sku.toLowerCase()===code.trim().toLowerCase());if(!p){$("scanMsg").textContent=`Barcode "${code}" tidak ditemukan di daftar bahan.`;return}select(p.sku);$("scanMsg").textContent=`Ketemu: ${p.nama}`;stopScanner()},()=>{});scanning=true;$("scanMsg").textContent="Kamera aktif, arahkan ke barcode..."}catch(e){console.error(e);$("scanMsg").textContent="Gagal akses kamera";await stopScanner()}
    };

    $("btnSubmit").onclick=async()=>{
      const p=allBahan.find(x=>x.sku===selectedSku),qty=Number($("fQty").value),user=petugas();
      if(!user)return msg("Sesi login gak valid, coba login ulang","err");
      if(!p)return msg("Pilih bahan dulu","err");
      if(!Number.isFinite(qty)||qty<=0)return msg("Jumlah harus lebih dari 0","err");
      const payload={tipe:currentTipe,sku:p.sku,qty,satuan:p.satuan,keterangan:$("fKeterangan").value.trim(),petugas:user,exp:currentTipe==="Masuk"?$("fExp").value:""};
      $("btnSubmit").disabled=true;msg("Menyimpan...");
      try{const r=await fetch(`${API_URL}/api/transaksi`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||"Transaksi gagal");msg(j.message||"Transaksi berhasil","ok");$("fQty").value="1";$("fKeterangan").value="";$("fExp").value="";$("fBahanSearch").value="";selectedSku="";$("fBahanResults").classList.add("hidden");await loadBahan(false)}catch(e){console.error(e);msg(e.message||"Gagal terhubung ke server","err")}finally{$("btnSubmit").disabled=false}
    };

    setTipe("Masuk");loadBahan();
  </script>
</Layout>
