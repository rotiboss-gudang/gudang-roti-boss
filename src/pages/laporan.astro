---
import Layout from "../layouts/Layout.astro";
---

<Layout active="laporan">
  <div class="card">
    <h2 class="sectionTitle">⚠️ Kondisi Gudang Saat Ini</h2>
    <div class="statGrid" id="statGrid">Memuat...</div>
    <div id="perhatianList"></div>
    <div id="inventarisBox" class="inventoryReport">Memuat daftar inventaris...</div>
  </div>

  <div class="card">
    <h2 class="sectionTitle">📊 Ringkasan Transaksi</h2>

    <div class="dateRow">
      <div>
        <label>Dari tanggal</label>
        <input type="date" id="startDate" />
      </div>

      <div>
        <label>Sampai tanggal</label>
        <input type="date" id="endDate" />
      </div>
    </div>

    <button id="btnLoad" class="btn-primary">
      Tampilkan Ringkasan
    </button>

    <div id="ringkasanBox"></div>
  </div>

  <div class="card">
  <h2 class="sectionTitle">📄 Laporan PDF</h2>

  <p class="hint">
    Pilih tanggal acuan, lalu cetak laporan sesuai kebutuhan.
  </p>

  <div class="pdfGrid">

    <button id="btnPdfHarian" class="btn-primary">
      📄 Laporan Harian
    </button>

    <button id="btnPdfMingguan" class="btn-primary">
      📅 Laporan Mingguan
    </button>

    <button id="btnPdfBulanan" class="btn-primary">
      🗓️ Laporan Bulanan
    </button>

    <button id="btnPdfOpname" class="btn-primary">
      📦 Laporan Stock Opname
    </button>

  </div>

  <div id="pdfMsg"></div>
</div>


  <style is:global>
    .sectionTitle {
      margin-bottom: 12px;
      font-size: 1rem;
    }

    .statGrid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }

    .statBox {
      background: #f9f5f0;
      border-radius: 10px;
      padding: 10px 6px;
      text-align: center;
    }

    .statBox .num {
      font-size: 1.4rem;
      font-weight: 700;
    }

    .statBox .label {
      font-size: 0.68rem;
      color: #8a7566;
      margin-top: 2px;
    }

    .aman {
      color: #2e7d32;
    }

    .menipis {
      color: #b5651d;
    }

    .expired {
      color: #c62828;
    }

    .attItem {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px solid #f0f0f0;
      font-size: 0.82rem;
    }

    .attItem:last-child {
      border-bottom: none;
    }

    .attTag {
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 20px;
    }

    .attTag.menipis {
      background: #fdecd2;
      color: #b5651d;
    }

    .attTag.expired {
      background: #fbdcdc;
      color: #b52a2a;
    }

    .inventoryReport { margin-top: 14px; overflow-x: auto; }
    .inventoryReport table { width: 100%; border-collapse: collapse; font-size: .72rem; }
    .inventoryReport th, .inventoryReport td { border: 1px solid #e4ddd7; padding: 6px; text-align: left; white-space: nowrap; }
    .inventoryReport th { background: #5c3d2e; color: #fff; }
    .inventoryReport td:nth-child(5), .inventoryReport td:nth-child(7) { text-align: right; }
    .inventoryReport .statusAman { color: #2e7d32; font-weight: 700; }
    .inventoryReport .statusWarning { color: #c62828; font-weight: 700; }

    label {
      display: block;
      font-size: 0.75rem;
      color: #8a7566;
      margin-bottom: 4px;
    }

    .dateRow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }

    input[type="date"] {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #fafafa;
      font-size: 0.85rem;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      background: #5c3d2e;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-weight: 600;
    }

    .btn-primary:disabled {
      opacity: 0.6;
    }

    .hint {
      font-size: 0.78rem;
      color: #8a7566;
      margin-bottom: 12px;
    }

    #ringkasanBox {
      margin-top: 14px;
    }

    .ringkasanGrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .ringkasanCard {
      background: #f9f5f0;
      border-radius: 10px;
      padding: 12px;
      min-width: 0;
    }

    .ringkasanCard .num {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.3;
      word-break: break-word;
    }

    .ringkasanCard .label {
      font-size: 0.72rem;
      color: #8a7566;
      margin-top: 3px;
    }

    #pdfMsg {
      font-size: 0.85rem;
      margin-top: 10px;
    }

    #pdfMsg.ok {
      color: #2e7d32;
    }

    #pdfMsg.err {
      color: #c62828;
    }

    #pdfMsg a {
      color: #2e7d32;
      font-weight: 700;
    }

    .pdfGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.pdfGrid .btn-primary {
  margin: 0;
}

@media (max-width: 420px) {
  .pdfGrid {
    grid-template-columns: 1fr;
  }
}

  </style>


  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL;
    function escHtml(value) { return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // ==========================================================
    // PETUGAS
    // ==========================================================

    function getPetugas() {
      try {
        const data = localStorage.getItem('gudangPetugas');

        if (!data) return '';

        const petugas = JSON.parse(data);

        return petugas.nama || '';

      } catch (err) {
        console.error('Error getPetugas:', err);
        return '';
      }
    }


    // ==========================================================
    // FORMAT TANGGAL
    // ==========================================================

    function fmtDate(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');

      return `${year}-${month}-${day}`;
    }


    // ==========================================================
    // FORMAT QTY BERDASARKAN SATUAN
    //
    // PENTING:
    // Jangan pernah menjumlahkan qty dengan satuan berbeda.
    //
    // Contoh:
    // 2 kg + 0.5 kg + 100 gram
    //
    // Hasil:
    // 2.5 kg + 100 gram
    // ==========================================================

    function formatQtyByUnit(data, tipeFilter) {

      const totals = {};

      data.forEach(t => {

        const ket = t.keterangan || '';

        // Jangan hitung transaksi yang dibatalkan
        if (ket.indexOf('[DIBATALKAN]') !== -1) {
          return;
        }


        // ------------------------------------------------------
        // FILTER PRODUKSI
        // ------------------------------------------------------

        if (tipeFilter === 'PRODUKSI') {

          if (ket.indexOf('Produksi') !== 0) {
            return;
          }

        }

        // ------------------------------------------------------
        // FILTER TRANSAKSI BIASA
        // ------------------------------------------------------

        else {

          if (t.tipe !== tipeFilter) {
            return;
          }

        }


        const qty = parseFloat(t.qty) || 0;

        const unit = (t.satuan || '').trim() || '-';


        if (!totals[unit]) {
          totals[unit] = 0;
        }

        totals[unit] += qty;

      });


      const entries = Object.entries(totals);


      if (entries.length === 0) {
        return '0';
      }


      return entries
        .map(([unit, qty]) => {

          const angka = Number.isInteger(qty)
            ? qty
            : parseFloat(qty.toFixed(3));

          return `${angka} ${unit}`;

        })
        .join(' + ');
    }


    // ==========================================================
    // KONDISI GUDANG
    // ==========================================================

    async function loadKondisi() {

      try {

        const res = await fetch(`${API_URL}/api/bahan?_=${Date.now()}`, { cache: 'no-store' });
        const payload = await res.json();
        if (!res.ok || !payload.success) throw new Error(payload.message || 'Gagal mengambil bahan');
        const bahan = Array.isArray(payload.data) ? payload.data : [];
        const now = Date.now();
        const data = {
          totalJenis: bahan.length,
          menipis: bahan.filter(b => Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0)).length,
          expired: bahan.filter(b => b.expired && new Date(b.expired).getTime() < now).length,
          expiredSoon: 0,
          perhatian: bahan.filter(b => Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0) || b.expired).map(b => ({ ...b, status: Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0) ? 'MENIPIS' : 'EXPIRED' }))
        };
        document.getElementById('inventarisBox').innerHTML = bahan.length ? `<table><thead><tr><th>SKU</th><th>Bahan</th><th>Stok</th><th>Satuan</th><th>Min.</th><th>Expired</th><th>Status</th></tr></thead><tbody>${bahan.map(b => { const min = Number(b.minStok ?? b.min_stok ?? 0); const low = Number(b.stok) <= min; const status = low ? 'Menipis' : b.expired ? 'Expired' : 'Aman'; return `<tr><td>${escHtml(b.sku)}</td><td>${escHtml(b.nama)}</td><td>${escHtml(b.stok)}</td><td>${escHtml(b.satuan)}</td><td>${escHtml(min)}</td><td>${escHtml(b.expired || '-')}</td><td class="${low || b.expired ? 'statusWarning' : 'statusAman'}">${status}</td></tr>`; }).join('')}</tbody></table>` : '<p class="emptyState">Belum ada bahan.</p>';


        document.getElementById('statGrid').innerHTML = `

          <div class="statBox">
            <div class="num">
              ${data.totalJenis}
            </div>

            <div class="label">
              Jenis Bahan
            </div>
          </div>


          <div class="statBox">
            <div class="num menipis">
              ${data.menipis}
            </div>

            <div class="label">
              Menipis
            </div>
          </div>


          <div class="statBox">
            <div class="num expired">
              ${data.expired + data.expiredSoon}
            </div>

            <div class="label">
              Expired/Segera
            </div>
          </div>

        `;


        const attEl =
          document.getElementById('perhatianList');


        if (data.perhatian.length === 0) {

          attEl.innerHTML = `
            <p style="
              color:#8a7566;
              font-size:0.85rem;
              margin-top:8px;
            ">
              Semua bahan aman ✅
            </p>
          `;

        }

        else {

          attEl.innerHTML =
            data.perhatian.map(p => {

              const tagCls =
                p.status === 'MENIPIS'
                  ? 'menipis'
                  : 'expired';


              const tagTxt =
                p.status === 'MENIPIS'
                  ? 'Menipis'
                  : (
                      p.expired
                        ? `Exp ${p.expired}`
                        : 'Expired'
                    );


              return `
                <div class="attItem">

                  <span>
                    ${p.nama}
                  </span>

                  <span class="attTag ${tagCls}">
                    ${tagTxt}
                  </span>

                </div>
              `;

            }).join('');

        }

      }

      catch (err) {

        console.error(
          'Error loadKondisi:',
          err
        );

        document.getElementById(
          'statGrid'
        ).innerHTML = `
          <p style="color:#c62828;">
            Gagal memuat data.
          </p>
        `;
      }
    }


    // ==========================================================
    // BUTTON RINGKASAN
    // ==========================================================

    document
      .getElementById('btnLoad')
      .addEventListener(
        'click',
        loadRingkasan
      );


    // ==========================================================
    // RINGKASAN TRANSAKSI
    // ==========================================================

    async function loadRingkasan() {

      const box =
        document.getElementById(
          'ringkasanBox'
        );

      box.innerHTML = 'Memuat...';


      try {

        const start =
          document.getElementById(
            'startDate'
          ).value;


        const end =
          document.getElementById(
            'endDate'
          ).value;


        let url =
          `${API_URL}?action=getRiwayat&filterTipe=all`;


        if (start) {
          url += `&startDate=${start}`;
        }


        if (end) {
          url += `&endDate=${end}`;
        }


        const res =
          await fetch(url);


        const data =
          await res.json();


        // ======================================================
        // SESI PRODUKSI
        // ======================================================

        let opnameCount = 0;

        const produksiSet =
          new Set();


        data.forEach(t => {

          const ket =
            t.keterangan || '';


          // Jangan hitung transaksi batal
          if (
            ket.indexOf(
              '[DIBATALKAN]'
            ) !== -1
          ) {
            return;
          }


          // ----------------------------------------------------
          // PRODUKSI
          // ----------------------------------------------------

          if (
            ket.indexOf(
              'Produksi'
            ) === 0
          ) {

            const m =
              ket.match(
                /\[(PRD-[^\]]+)\]/
              );


            if (m) {
              produksiSet.add(
                m[1]
              );
            }

          }


          // ----------------------------------------------------
          // STOCK OPNAME
          // ----------------------------------------------------

          else if (
            ket.indexOf(
              'Stock Opname'
            ) === 0
          ) {

            opnameCount++;

          }

        });


        // ======================================================
        // RENDER RINGKASAN
        // ======================================================

        box.innerHTML = `

          <div class="ringkasanGrid">


            <!-- TOTAL TRANSAKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${data.length}
              </div>

              <div class="label">
                Total Transaksi
              </div>

            </div>


            <!-- TOTAL MASUK -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Masuk'
                )}
              </div>

              <div class="label">
                Total Masuk
              </div>

            </div>


            <!-- TOTAL KELUAR MANUAL -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Keluar'
                )}
              </div>

              <div class="label">
                Total Keluar Manual
              </div>

            </div>


            <!-- SESI PRODUKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${produksiSet.size}
              </div>

              <div class="label">
                Sesi Produksi
              </div>

            </div>


            <!-- TOTAL PRODUKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'PRODUKSI'
                )}
              </div>

              <div class="label">
                Total Bahan Terpakai Produksi
              </div>

            </div>


            <!-- STOCK OPNAME -->

            <div class="ringkasanCard">

              <div class="num">
                ${opnameCount}
              </div>

              <div class="label">
                Penyesuaian Opname
              </div>

            </div>


            <!-- RUSAK / EXPIRED -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Rusak-Expired'
                )}
              </div>

              <div class="label">
                Rusak / Expired
              </div>

            </div>


          </div>

        `;

      }

          catch (err) {

      console.error(
        'Error loadRingkasan:',
        err
      );

      box.innerHTML = `
        <p style="color:#c62828;">
          Gagal memuat ringkasan.
        </p>
      `;
    }

  } // ← tutup function loadRingkasan


// ==========================================================
// GENERATE PDF
// ==========================================================

async function generatePdf(reportType) {

  const msgEl =
    document.getElementById('pdfMsg');

  const tanggal =
    document.getElementById('startDate').value
    || fmtDate(new Date());

  const buttons = [
    'btnPdfHarian',
    'btnPdfMingguan',
    'btnPdfBulanan',
    'btnPdfOpname'
  ];

  buttons.forEach(id => {

    const btn =
      document.getElementById(id);

    if (btn) {
      btn.disabled = true;
    }

  });

  msgEl.textContent =
    'Sedang bikin PDF, tunggu sebentar...';

  msgEl.className = '';

  try {

    const res =
      await fetch(
        API_URL,
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'text/plain;charset=utf-8'
          },

          body: JSON.stringify({

            action: 'generateLaporan',

            data: {

              tanggal: tanggal,

              tipe: reportType,

              petugas: getPetugas()

            }

          })

        }
      );


    const result =
      await res.json();


    if (result.success) {

      msgEl.innerHTML = `
        PDF berhasil dibuat!
        <a
          href="${result.pdfUrl}"
          target="_blank"
        >
          Buka PDF
        </a>
      `;

      msgEl.className = 'ok';

    }

    else {

      msgEl.textContent =
        'Gagal: ' +
        (
          result.message
          || 'unknown error'
        );

      msgEl.className = 'err';

    }

  }

  catch (err) {

    console.error(
      'ERROR generatePdf:',
      err
    );

    msgEl.textContent =
      'Error: ' +
      err.message;

    msgEl.className = 'err';

  }

  finally {

    buttons.forEach(id => {

      const btn =
        document.getElementById(id);

      if (btn) {
        btn.disabled = false;
      }

    });

  }

}


// ==========================================================
// BUTTON LAPORAN
// ==========================================================

document
  .getElementById('btnPdfHarian')
  .addEventListener(
    'click',
    () => generatePdf('daily')
  );

document
  .getElementById('btnPdfMingguan')
  .addEventListener(
    'click',
    () => generatePdf('weekly')
  );

document
  .getElementById('btnPdfBulanan')
  .addEventListener(
    'click',
    () => generatePdf('monthly')
  );

document
  .getElementById('btnPdfOpname')
  .addEventListener(
    'click',
    () => generatePdf('opname')
  );


// ==========================================================
// INIT
// ==========================================================

loadKondisi();

  </script>
</Layout>