---
import Layout from "../layouts/Layout.astro";
---

<Layout active="laporan">
  <div class="card">
    <h2 class="sectionTitle">⚠️ Kondisi Gudang Saat Ini</h2>
    <div class="statGrid" id="statGrid">Memuat...</div>
    <div id="perhatianList"></div>
    <div id="inventarisBox" class="inventoryReport">Memuat daftar inventaris...</div>
  </div>

  <div class="card">
    <h2 class="sectionTitle">📊 Ringkasan Transaksi</h2>

    <div class="dateRow">
      <div>
        <label>Dari tanggal</label>
        <input type="date" id="startDate" />
      </div>

      <div>
        <label>Sampai tanggal</label>
        <input type="date" id="endDate" />
      </div>
    </div>

    <button id="btnLoad" class="btn-primary">
      Tampilkan Ringkasan
    </button>

    <div id="ringkasanBox"></div>
  </div>

  <div class="card">
  <h2 class="sectionTitle">📄 Laporan PDF</h2>

  <p class="hint">
    Pilih tanggal acuan, lalu cetak laporan sesuai kebutuhan.
  </p>

  <div class="reportActions">
    <div class="reportActionRow"><span>📄 Laporan Harian</span><div><button id="btnPdfHarian" class="btn-pdf">PDF</button><button id="btnExcelHarian" class="btn-excel">Excel</button></div></div>
    <div class="reportActionRow"><span>📅 Laporan Mingguan</span><div><button id="btnPdfMingguan" class="btn-pdf">PDF</button><button id="btnExcelMingguan" class="btn-excel">Excel</button></div></div>
    <div class="reportActionRow"><span>🗓️ Laporan Bulanan</span><div><button id="btnPdfBulanan" class="btn-pdf">PDF</button><button id="btnExcelBulanan" class="btn-excel">Excel</button></div></div>
    <div class="reportActionRow"><span>📦 Laporan Stock Opname</span><div><button id="btnPdfOpname" class="btn-pdf">PDF</button><button id="btnExcelOpname" class="btn-excel">Excel</button></div></div>
  </div>

  <div id="pdfMsg"></div>
</div>


  <style is:global>
    .sectionTitle {
      margin-bottom: 12px;
      font-size: 1rem;
    }

    .statGrid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }

    .statBox {
      background: #f9f5f0;
      border-radius: 10px;
      padding: 10px 6px;
      text-align: center;
    }

    .statBox .num {
      font-size: 1.4rem;
      font-weight: 700;
    }

    .statBox .label {
      font-size: 0.68rem;
      color: #8a7566;
      margin-top: 2px;
    }

    .aman {
      color: #2e7d32;
    }

    .menipis {
      color: #b5651d;
    }

    .expired {
      color: #c62828;
    }

    .attItem {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px solid #f0f0f0;
      font-size: 0.82rem;
    }

    .attItem:last-child {
      border-bottom: none;
    }

    .attTag {
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 20px;
    }

    .attTag.menipis {
      background: #fdecd2;
      color: #b5651d;
    }

    .attTag.expired {
      background: #fbdcdc;
      color: #b52a2a;
    }

    .inventoryReport { margin-top: 14px; overflow-x: auto; }
    .inventoryReport table { width: 100%; border-collapse: collapse; font-size: .72rem; }
    .inventoryReport th, .inventoryReport td { border: 1px solid #e4ddd7; padding: 6px; text-align: left; white-space: nowrap; }
    .inventoryReport th { background: #5c3d2e; color: #fff; }
    .inventoryReport td:nth-child(5), .inventoryReport td:nth-child(7) { text-align: right; }
    .inventoryReport .statusAman { color: #2e7d32; font-weight: 700; }
    .inventoryReport .statusWarning { color: #c62828; font-weight: 700; }

    label {
      display: block;
      font-size: 0.75rem;
      color: #8a7566;
      margin-bottom: 4px;
    }

    .dateRow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }

    input[type="date"] {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #fafafa;
      font-size: 0.85rem;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      background: #5c3d2e;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-weight: 600;
    }

    .btn-primary:disabled {
      opacity: 0.6;
    }

    .hint {
      font-size: 0.78rem;
      color: #8a7566;
      margin-bottom: 12px;
    }

    #ringkasanBox {
      margin-top: 14px;
    }

    .ringkasanGrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .ringkasanCard {
      background: #f9f5f0;
      border-radius: 10px;
      padding: 12px;
      min-width: 0;
    }

    .ringkasanCard .num {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.3;
      word-break: break-word;
    }

    .ringkasanCard .label {
      font-size: 0.72rem;
      color: #8a7566;
      margin-top: 3px;
    }

    #pdfMsg {
      font-size: 0.85rem;
      margin-top: 10px;
    }

    #pdfMsg.ok {
      color: #2e7d32;
    }

    #pdfMsg.err {
      color: #c62828;
    }

    #pdfMsg a {
      color: #2e7d32;
      font-weight: 700;
    }

    .reportActions { display:grid; gap:9px; }
    .reportActionRow { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:10px; border:1px solid #eadfd6; border-radius:11px; background:#faf7f3; font-weight:700; font-size:.84rem; }
    .reportActionRow > div { display:flex; gap:6px; flex-shrink:0; }
    .btn-pdf, .btn-excel { border:0; border-radius:8px; padding:9px 12px; color:#fff; font-weight:700; }
    .btn-pdf { background:#7a4b3a; } .btn-excel { background:#217346; }
    .btn-pdf:disabled, .btn-excel:disabled { opacity:.55; }
    @media (max-width: 420px) { .reportActionRow { align-items:flex-start; flex-direction:column; } .reportActionRow > div { width:100%; } .btn-pdf, .btn-excel { flex:1; } }

  </style>


  <script>
    import * as XLSX from 'xlsx';
    const API_URL = import.meta.env.PUBLIC_API_URL || "https://gudang-roti-boss-worker.masbamganteng.workers.dev";
    function escHtml(value) { return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // ==========================================================
    // PETUGAS
    // ==========================================================

    function getPetugas() {
      try {
        const data = localStorage.getItem('gudangPetugas');

        if (!data) return '';

        const petugas = JSON.parse(data);

        return petugas.nama || '';

      } catch (err) {
        console.error('Error getPetugas:', err);
        return '';
      }
    }


    // ==========================================================
    // FORMAT TANGGAL
    // ==========================================================

    function fmtDate(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');

      return `${year}-${month}-${day}`;
    }


    // ==========================================================
    // FORMAT QTY BERDASARKAN SATUAN
    //
    // PENTING:
    // Jangan pernah menjumlahkan qty dengan satuan berbeda.
    //
    // Contoh:
    // 2 kg + 0.5 kg + 100 gram
    //
    // Hasil:
    // 2.5 kg + 100 gram
    // ==========================================================

    function formatQtyByUnit(data, tipeFilter) {

      const totals = {};

      data.forEach(t => {

        const ket = t.keterangan || '';

        // Jangan hitung transaksi yang dibatalkan
        if (ket.indexOf('[DIBATALKAN]') !== -1) {
          return;
        }


        // ------------------------------------------------------
        // FILTER PRODUKSI
        // ------------------------------------------------------

        if (tipeFilter === 'PRODUKSI') {

          if (ket.indexOf('Produksi') !== 0) {
            return;
          }

        }

        // ------------------------------------------------------
        // FILTER TRANSAKSI BIASA
        // ------------------------------------------------------

        else {

          if (t.tipe !== tipeFilter) {
            return;
          }

          // Transaksi Keluar dari BOM/Produksi ditampilkan terpisah.
          if (tipeFilter === 'Keluar' && ket.indexOf('Produksi') === 0) {
            return;
          }

        }


        const qty = parseFloat(t.qty) || 0;

        const unit = (t.satuan || '').trim() || '-';


        if (!totals[unit]) {
          totals[unit] = 0;
        }

        totals[unit] += qty;

      });


      const entries = Object.entries(totals);


      if (entries.length === 0) {
        return '0';
      }


      return entries
        .map(([unit, qty]) => {

          const angka = Number.isInteger(qty)
            ? qty
            : parseFloat(qty.toFixed(3));

          return `${angka} ${unit}`;

        })
        .join(' + ');
    }


    // ==========================================================
    // KONDISI GUDANG
    // ==========================================================

    async function loadKondisi() {

      try {

        const res = await fetch(`${API_URL}/api/bahan?_=${Date.now()}`, { cache: 'no-store' });
        const payload = await res.json();
        if (!res.ok || !payload.success) throw new Error(payload.message || 'Gagal mengambil bahan');
        const bahan = Array.isArray(payload.data) ? payload.data : [];
        const now = Date.now();
        const data = {
          totalJenis: bahan.length,
          menipis: bahan.filter(b => Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0)).length,
          expired: bahan.filter(b => b.expired && new Date(b.expired).getTime() < now).length,
          expiredSoon: 0,
          perhatian: bahan.filter(b => Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0) || b.expired).map(b => ({ ...b, status: Number(b.stok) <= Number(b.minStok ?? b.min_stok ?? 0) ? 'MENIPIS' : 'EXPIRED' }))
        };
        document.getElementById('inventarisBox').innerHTML = bahan.length ? `<table><thead><tr><th>SKU</th><th>Bahan</th><th>Stok</th><th>Satuan</th><th>Min.</th><th>Expired</th><th>Status</th></tr></thead><tbody>${bahan.map(b => { const min = Number(b.minStok ?? b.min_stok ?? 0); const low = Number(b.stok) <= min; const status = low ? 'Menipis' : b.expired ? 'Expired' : 'Aman'; return `<tr><td>${escHtml(b.sku)}</td><td>${escHtml(b.nama)}</td><td>${escHtml(b.stok)}</td><td>${escHtml(b.satuan)}</td><td>${escHtml(min)}</td><td>${escHtml(b.expired || '-')}</td><td class="${low || b.expired ? 'statusWarning' : 'statusAman'}">${status}</td></tr>`; }).join('')}</tbody></table>` : '<p class="emptyState">Belum ada bahan.</p>';


        document.getElementById('statGrid').innerHTML = `

          <div class="statBox">
            <div class="num">
              ${data.totalJenis}
            </div>

            <div class="label">
              Jenis Bahan
            </div>
          </div>


          <div class="statBox">
            <div class="num menipis">
              ${data.menipis}
            </div>

            <div class="label">
              Menipis
            </div>
          </div>


          <div class="statBox">
            <div class="num expired">
              ${data.expired + data.expiredSoon}
            </div>

            <div class="label">
              Expired/Segera
            </div>
          </div>

        `;


        const attEl =
          document.getElementById('perhatianList');


        if (data.perhatian.length === 0) {

          attEl.innerHTML = `
            <p style="
              color:#8a7566;
              font-size:0.85rem;
              margin-top:8px;
            ">
              Semua bahan aman ✅
            </p>
          `;

        }

        else {

          attEl.innerHTML =
            data.perhatian.map(p => {

              const tagCls =
                p.status === 'MENIPIS'
                  ? 'menipis'
                  : 'expired';


              const tagTxt =
                p.status === 'MENIPIS'
                  ? 'Menipis'
                  : (
                      p.expired
                        ? `Exp ${p.expired}`
                        : 'Expired'
                    );


              return `
                <div class="attItem">

                  <span>
                    ${p.nama}
                  </span>

                  <span class="attTag ${tagCls}">
                    ${tagTxt}
                  </span>

                </div>
              `;

            }).join('');

        }

      }

      catch (err) {

        console.error(
          'Error loadKondisi:',
          err
        );

        document.getElementById(
          'statGrid'
        ).innerHTML = `
          <p style="color:#c62828;">
            Gagal memuat data.
          </p>
        `;
      }
    }


    // ==========================================================
    // BUTTON RINGKASAN
    // ==========================================================

    document
      .getElementById('btnLoad')
      .addEventListener(
        'click',
        loadRingkasan
      );


    // ==========================================================
    // RINGKASAN TRANSAKSI
    // ==========================================================

    async function loadRingkasan() {

      const box =
        document.getElementById(
          'ringkasanBox'
        );

      box.innerHTML = 'Memuat...';


      try {

        const start =
          document.getElementById(
            'startDate'
          ).value;


        const end =
          document.getElementById(
            'endDate'
          ).value;


        let url =
          `${API_URL}?action=getRiwayat&filterTipe=all`;


        if (start) {
          url += `&startDate=${start}`;
        }


        if (end) {
          url += `&endDate=${end}`;
        }


        const res =
          await fetch(url);


        const data =
          await res.json();


        // ======================================================
        // SESI PRODUKSI
        // ======================================================

        let opnameCount = 0;

        const produksiSet =
          new Set();


        data.forEach(t => {

          const ket =
            t.keterangan || '';


          // Jangan hitung transaksi batal
          if (
            ket.indexOf(
              '[DIBATALKAN]'
            ) !== -1
          ) {
            return;
          }


          // ----------------------------------------------------
          // PRODUKSI
          // ----------------------------------------------------

          if (
            ket.indexOf(
              'Produksi'
            ) === 0
          ) {

            const m =
              ket.match(
                /\[(PRD-[^\]]+)\]/
              );


            if (m) {
              produksiSet.add(
                m[1]
              );
            }

          }


          // ----------------------------------------------------
          // STOCK OPNAME
          // ----------------------------------------------------

          else if (
            ket.indexOf(
              'Stock Opname'
            ) === 0
          ) {

            opnameCount++;

          }

        });


        // ======================================================
        // RENDER RINGKASAN
        // ======================================================

        box.innerHTML = `

          <div class="ringkasanGrid">


            <!-- TOTAL TRANSAKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${data.length}
              </div>

              <div class="label">
                Total Transaksi
              </div>

            </div>


            <!-- TOTAL MASUK -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Masuk'
                )}
              </div>

              <div class="label">
                Total Masuk
              </div>

            </div>


            <!-- TOTAL KELUAR MANUAL -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Keluar'
                )}
              </div>

              <div class="label">
                Total Keluar Manual
              </div>

            </div>


            <!-- SESI PRODUKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${produksiSet.size}
              </div>

              <div class="label">
                Sesi Produksi
              </div>

            </div>


            <!-- TOTAL PRODUKSI -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'PRODUKSI'
                )}
              </div>

              <div class="label">
                Total Bahan Terpakai Produksi
              </div>

            </div>


            <!-- STOCK OPNAME -->

            <div class="ringkasanCard">

              <div class="num">
                ${opnameCount}
              </div>

              <div class="label">
                Penyesuaian Opname
              </div>

            </div>


            <!-- RUSAK / EXPIRED -->

            <div class="ringkasanCard">

              <div class="num">
                ${formatQtyByUnit(
                  data,
                  'Rusak-Expired'
                )}
              </div>

              <div class="label">
                Rusak / Expired
              </div>

            </div>


          </div>

        `;

      }

          catch (err) {

      console.error(
        'Error loadRingkasan:',
        err
      );

      box.innerHTML = `
        <p style="color:#c62828;">
          Gagal memuat ringkasan.
        </p>
      `;
    }

  } // ← tutup function loadRingkasan


// ==========================================================
// EXPORT EXCEL
// ==========================================================

function excelPeriod(reportType, anchor) {
  const d = new Date(`${anchor}T12:00:00`);
  if (reportType === 'daily') return { start: anchor, end: anchor, label: anchor };
  if (reportType === 'monthly') {
    const start = new Date(d.getFullYear(), d.getMonth(), 1), end = new Date(d.getFullYear(), d.getMonth() + 1, 0);
    return { start: fmtDate(start), end: fmtDate(end), label: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` };
  }
  const day = d.getDay(), diff = day === 0 ? -6 : 1 - day;
  const start = new Date(d); start.setDate(d.getDate() + diff);
  const end = new Date(start); end.setDate(start.getDate() + 6);
  return { start: fmtDate(start), end: fmtDate(end), label: `${fmtDate(start)}-sd-${fmtDate(end)}` };
}

async function fetchRiwayatRange(start, end) {
  const res = await fetch(`${API_URL}?action=getRiwayat&filterTipe=all&startDate=${start}&endDate=${end}`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const data = await res.json();
  if (!Array.isArray(data)) throw new Error('Format data transaksi tidak valid');
  return data;
}

function downloadWorkbook(wb, filename) {
  XLSX.writeFile(wb, filename, { bookType: 'xlsx', compression: true });
}

async function generateExcel(reportType) {
  const msgEl = document.getElementById('pdfMsg');
  const anchor = document.getElementById('startDate').value || fmtDate(new Date());
  const ids = ['btnExcelHarian','btnExcelMingguan','btnExcelBulanan','btnExcelOpname'];
  ids.forEach(id => { const b = document.getElementById(id); if (b) b.disabled = true; });
  msgEl.textContent = 'Sedang menyiapkan Excel...'; msgEl.className = '';
  try {
    const wb = XLSX.utils.book_new();
    if (reportType === 'opname') {
      const [bahanRes, trx] = await Promise.all([fetch(`${API_URL}?action=getMasterData`).then(r => r.json()), fetchRiwayatRange('2000-01-01', '2999-12-31')]);
      const bahan = Array.isArray(bahanRes) ? bahanRes : [];
      const latest = new Map();
      trx.filter(t => String(t.keterangan || '').startsWith('Stock Opname') && !String(t.keterangan || '').includes('[DIBATALKAN]')).forEach(t => { if (!latest.has(t.sku)) latest.set(t.sku, t); });
      const rows = bahan.map((b, i) => { const r = latest.get(b.sku), sistem = r ? Number(r.stok_awal) : Number(b.stok), fisik = r ? Number(r.stok_akhir) : null, selisih = fisik === null ? null : fisik - sistem; return { No: i + 1, SKU: b.sku, Bahan: b.nama, 'Stok Sistem': sistem, 'Stok Fisik': fisik, Selisih: selisih, Satuan: b.satuan, Status: !r ? 'Belum Diperiksa' : selisih === 0 ? 'Sesuai' : 'Selisih', Keterangan: !r ? 'Belum ada hasil opname' : selisih === 0 ? 'Tidak ada selisih' : selisih < 0 ? `Kurang ${Math.abs(selisih)} ${b.satuan}` : `Lebih ${selisih} ${b.satuan}`, Petugas: r?.petugas || '', Waktu: r?.timestamp || '' }; });
      const ws = XLSX.utils.json_to_sheet(rows); ws['!cols'] = [6,14,24,14,14,12,12,18,28,18,24].map(w => ({wch:w})); ws['!autofilter'] = { ref: ws['!ref'] }; ws['!freeze'] = { xSplit:0, ySplit:1 }; XLSX.utils.book_append_sheet(wb, ws, 'Hasil Opname Terakhir');
      downloadWorkbook(wb, 'Laporan-Stock-Opname-Terakhir.xlsx');
    } else {
      const period = excelPeriod(reportType, anchor), trx = await fetchRiwayatRange(period.start, period.end), active = trx.filter(t => !String(t.keterangan || '').includes('[DIBATALKAN]'));
      const summaryTypes = [['Bahan Baru','Bahan Baru'],['Masuk','Masuk'],['Produksi','PRODUKSI'],['Keluar','Keluar'],['Rusak-Expired','Rusak-Expired'],['Opname','Opname']];
      const summary = summaryTypes.map(([label, type]) => { const rows = type === 'PRODUKSI' ? active.filter(t => String(t.keterangan || '').startsWith('Produksi')) : active.filter(t => t.tipe === type && !(type === 'Keluar' && String(t.keterangan || '').startsWith('Produksi'))); return { Jenis: label, 'Jumlah Entri': rows.length }; });
      summary.push({ Jenis: 'Total', 'Jumlah Entri': summary.reduce((n, r) => n + r['Jumlah Entri'], 0) });
      const detail = active.map((t, i) => ({ No: i + 1, Waktu: t.timestamp || '', Tipe: t.tipe || '', SKU: t.sku || '', Bahan: t.nama || t.nama_bahan || '', Jumlah: Number(t.qty) || 0, Satuan: t.satuan || '', Petugas: t.petugas || '', Keterangan: t.keterangan || '' }));
      const produksi = active.filter(t => String(t.keterangan || '').startsWith('Produksi')).map((t, i) => ({ No: i + 1, Waktu: t.timestamp || '', Bahan: t.nama || '', Jumlah: Number(t.qty) || 0, Satuan: t.satuan || '', Petugas: t.petugas || '', Keterangan: t.keterangan || '' }));
      const ws1 = XLSX.utils.json_to_sheet([{ Laporan: `Laporan ${reportType === 'daily' ? 'Harian' : reportType === 'weekly' ? 'Mingguan' : 'Bulanan'}` }, { Periode: `${period.start} s/d ${period.end}` }, {}, ...summary]); ws1['!cols'] = [{wch:24},{wch:18}]; XLSX.utils.book_append_sheet(wb, ws1, 'Ringkasan');
      const ws2 = XLSX.utils.json_to_sheet(detail); ws2['!cols'] = [6,24,16,14,26,12,12,18,36].map(w => ({wch:w})); ws2['!autofilter'] = { ref: ws2['!ref'] }; ws2['!freeze'] = { xSplit:0, ySplit:1 }; XLSX.utils.book_append_sheet(wb, ws2, 'Detail Transaksi');
      const ws3 = XLSX.utils.json_to_sheet(produksi); ws3['!cols'] = [6,24,26,12,12,18,36].map(w => ({wch:w})); ws3['!autofilter'] = { ref: ws3['!ref'] }; ws3['!freeze'] = { xSplit:0, ySplit:1 }; XLSX.utils.book_append_sheet(wb, ws3, 'Pemakaian Produksi');
      downloadWorkbook(wb, `Laporan-${reportType === 'daily' ? 'Harian' : reportType === 'weekly' ? 'Mingguan' : 'Bulanan'}-${period.label}.xlsx`);
    }
    msgEl.textContent = 'Excel berhasil diunduh.'; msgEl.className = 'ok';
  } catch (err) { console.error('ERROR generateExcel:', err); msgEl.textContent = `Gagal membuat Excel: ${err.message}`; msgEl.className = 'err'; }
  finally { ids.forEach(id => { const b = document.getElementById(id); if (b) b.disabled = false; }); }
}

// ==========================================================
// GENERATE PDF
// ==========================================================

async function generatePdf(reportType) {

  const msgEl =
    document.getElementById('pdfMsg');

  const tanggal =
    document.getElementById('startDate').value
    || fmtDate(new Date());

  const buttons = [
    'btnPdfHarian',
    'btnPdfMingguan',
    'btnPdfBulanan',
    'btnPdfOpname'
  ];

  buttons.forEach(id => {

    const btn =
      document.getElementById(id);

    if (btn) {
      btn.disabled = true;
    }

  });

  msgEl.textContent =
    'Sedang bikin PDF, tunggu sebentar...';

  msgEl.className = '';

  try {

    const res =
      await fetch(
        API_URL,
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'text/plain;charset=utf-8'
          },

          body: JSON.stringify({

            action: 'generateLaporan',

            data: {

              tanggal: tanggal,

              tipe: reportType,

              petugas: getPetugas()

            }

          })

        }
      );


    const result =
      await res.json();


    if (result.success) {

      msgEl.innerHTML = `
        PDF berhasil dibuat!
        <a
          href="${result.pdfUrl}"
          target="_blank"
        >
          Buka PDF
        </a>
      `;

      msgEl.className = 'ok';

    }

    else {

      msgEl.textContent =
        'Gagal: ' +
        (
          result.message
          || 'unknown error'
        );

      msgEl.className = 'err';

    }

  }

  catch (err) {

    console.error(
      'ERROR generatePdf:',
      err
    );

    msgEl.textContent =
      'Error: ' +
      err.message;

    msgEl.className = 'err';

  }

  finally {

    buttons.forEach(id => {

      const btn =
        document.getElementById(id);

      if (btn) {
        btn.disabled = false;
      }

    });

  }

}


// ==========================================================
// BUTTON LAPORAN
// ==========================================================

document
  .getElementById('btnPdfHarian')
  .addEventListener(
    'click',
    () => generatePdf('daily')
  );

document
  .getElementById('btnPdfMingguan')
  .addEventListener(
    'click',
    () => generatePdf('weekly')
  );

document
  .getElementById('btnPdfBulanan')
  .addEventListener(
    'click',
    () => generatePdf('monthly')
  );

document.getElementById('btnPdfOpname').addEventListener('click', () => generatePdf('opname'));
document.getElementById('btnExcelHarian').addEventListener('click', () => generateExcel('daily'));
document.getElementById('btnExcelMingguan').addEventListener('click', () => generateExcel('weekly'));
document.getElementById('btnExcelBulanan').addEventListener('click', () => generateExcel('monthly'));
document.getElementById('btnExcelOpname').addEventListener('click', () => generateExcel('opname'));


// ==========================================================
// INIT
// ==========================================================

loadKondisi();

  </script>
</Layout>